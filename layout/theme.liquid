    <!-- Global Scripts -->
    <script>
      NProgress.configure({ showSpinner: false });
      NProgress.done();
      async function logoutAccount() {
        try { await fetch('/api/storefront/v2/auth/logout', { method: 'POST' }); window.location.reload(); } catch (err) { window.location.reload(); }
      }
      document.addEventListener('click', e => {
        const a = e.target.closest('a');
        if (a && a.href && !a.href.startsWith('#') && !a.target && a.host === window.location.host) {
          if (a.href !== window.location.href) NProgress.start();
        }
      });

      {% if settings.discord.guild_id != blank %}
      fetch('https://discord.com/api/guilds/{{ settings.discord.guild_id | default: '1256991995147190272' }}/widget.json')
        .then(res => res.json())
        .then(data => {
          if (data.presence_count !== undefined) {
            document.querySelectorAll('.discord-live-count').forEach(el => {
              const format = el.getAttribute('data-format') || '{count}';
              el.textContent = format.replace('{count}', data.presence_count);
            });
          }
        }).catch(e => {});
      {% endif %}

      const serverIp = '{{ settings.server_ip | default: "mc.hypixel.net" }}';
      if (serverIp) {
        async function fetchServerStatus() {
          try {
            const res = await fetch(`https://mcapi.tr/api/v1/status/${serverIp}`);
            if (res.ok) { const data = await res.json(); if (data.online && data.players) return data.players.online; }
          } catch (e) {}
          return null;
        }
        fetchServerStatus().then(online => {
          document.querySelectorAll('.server-online-count').forEach(el => {
            if (online !== null) el.textContent = online;
            else el.textContent = '18';
          });
        });
      }

      function updateGlobalCartBadge() {
        try {
          const cart = JSON.parse(localStorage.getItem('cart') || '[]');
          const count = cart.reduce((sum, item) => sum + (item.quantity || 1), 0);
          document.querySelectorAll('.header-cart-badge').forEach((el) => {
            el.innerText = count;
            if (count > 0) el.classList.remove('hidden');
            else el.classList.add('hidden');
          });
        } catch (e) {}
      }
      window.addToCart = function (product, quantity = 1) {
        try {
          const productId = product.id || product._id;
          if (!productId) return;
          let cart = JSON.parse(localStorage.getItem('cart') || '[]');
          const idx = cart.findIndex((i) => (i.id || i._id) === productId);
          if (idx !== -1) cart[idx].quantity += quantity;
          else { product.quantity = quantity; product.id = productId; cart.push(product); }
          localStorage.setItem('cart', JSON.stringify(cart));
          updateGlobalCartBadge();
          window.showToast?.('Ürün envanterinize eklendi!', 'success');
        } catch (e) {}
      };
      document.addEventListener('DOMContentLoaded', updateGlobalCartBadge);
      window.addEventListener('storage', (e) => { if (e.key === 'cart') updateGlobalCartBadge(); });
    </script>

    <script>
      // Unified Continuous Page Transition Preloader Logic (Disabled in Preview Mode)
      (function() {
        const isPreview = window.location.search.includes('preview_theme_id') || 
                          window.location.search.includes('preview_ts') || 
                          (window.self !== window.top);

        const preloader = document.getElementById('rpg-page-preloader');
        if (isPreview) {
          if (preloader) {
            preloader.classList.add('preloader-hidden');
            preloader.style.display = 'none';
          }
          document.documentElement.classList.remove('rpg-is-preloading');
          return;
        }

        const barFill = document.getElementById('rpg-progress-bar-fill');
        let progressTimer = null;
        let currentProgress = parseFloat(sessionStorage.getItem('rpg_progress') || '0');

        function updateBar(val) {
          currentProgress = Math.min(100, Math.max(0, val));
          if (barFill) barFill.style.width = currentProgress + '%';
          sessionStorage.setItem('rpg_progress', currentProgress);
        }

        function startProgress() {
          if (!preloader) return;
          document.documentElement.classList.add('rpg-is-preloading');
          preloader.classList.remove('preloader-hidden');
          
          if (currentProgress <= 0 || currentProgress >= 95) {
            updateBar(10);
          } else {
            updateBar(currentProgress);
          }

          clearInterval(progressTimer);
          progressTimer = setInterval(() => {
            if (currentProgress < 90) {
              updateBar(currentProgress + (90 - currentProgress) * 0.14);
            }
          }, 100);
        }

        function finishProgress() {
          if (!preloader) return;
          clearInterval(progressTimer);
          updateBar(100);
          
          setTimeout(() => {
            document.documentElement.classList.remove('rpg-is-preloading');
            preloader.classList.add('preloader-hidden');
            setTimeout(() => {
              updateBar(0);
              sessionStorage.removeItem('rpg_progress');
            }, 600);
          }, 300);
        }

        if (sessionStorage.getItem('rpg_progress')) {
          startProgress();
        }

        if (document.readyState === 'complete') {
          setTimeout(finishProgress, 300);
        } else {
          window.addEventListener('load', () => {
            setTimeout(finishProgress, 350);
          });
        }

        setTimeout(finishProgress, 1800);

        document.addEventListener('click', (e) => {
          const link = e.target.closest('a');
          if (!link) return;
          const href = link.getAttribute('href');
          if (
            href &&
            !href.startsWith('#') &&
            !href.startsWith('javascript:') &&
            !href.startsWith('mailto:') &&
            !href.startsWith('tel:') &&
            link.target !== '_blank' &&
            !e.ctrlKey &&
            !e.metaKey
          ) {
            startProgress();
          }
        });

        window.addEventListener('pageshow', (e) => {
          if (e.persisted) finishProgress();
        });
      })();
    </script>

