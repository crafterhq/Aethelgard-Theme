              <h3 class="font-medieval font-bold text-[var(--color-gold-bright)] mb-5 uppercase tracking-widest text-xs border-b border-realm-border pb-2">Hızlı Menü</h3>
              <ul class="space-y-3 font-sans text-xs">
                {% if settings.footer.quick_links and settings.footer.quick_links.size > 0 %}
                  {% for link in settings.footer.quick_links %}
                    <li><a href="{{ link.url | default: '#' }}" class="text-slate-400 hover:text-[var(--color-gold-bright)] transition-colors">{{ link.title }}</a></li>
                  {% endfor %}
                {% else %}
                  <li><a href="/" class="text-slate-400 hover:text-[var(--color-gold-bright)] transition-colors">Anasayfa</a></li>
                  <li><a href="/store" class="text-slate-400 hover:text-[var(--color-gold-bright)] transition-colors">Mağaza</a></li>
                  <li><a href="/forum" class="text-slate-400 hover:text-[var(--color-gold-bright)] transition-colors">Forum</a></li>
                  <li><a href="/help" class="text-slate-400 hover:text-[var(--color-gold-bright)] transition-colors">Yardım</a></li>
                {% endif %}
              </ul>
            </div>

            <!-- Col 3: SOSYAL MEDYA -->
