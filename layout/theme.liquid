              {% assign default_logo = 'https://avatars.githubusercontent.com/u/3840546?s=280&v=4' %}
              <img
                src="{{ settings.footer.logo | default: settings.logo_dark | default: settings.logo_light | default: default_logo }}"
                alt="{{ shop.name }}"
                class="mb-4 object-contain filter drop-shadow-[0_2px_10px_rgba(212,175,55,0.4)]"
                style="max-height: 48px; width: {{ settings.footer.logo_width | default: 192 }}px;"
              >
              <p class="text-slate-400 text-xs leading-relaxed font-sans mb-6">
                {{ settings.footer.about | default: 'Türkiye\'nin en gelişmiş RPG & Orta Çağ Minecraft sunucu ağı. Loncanı kur ve adını altın harflerle yazdır.' }}
              </p>
              {% if settings.footer.contact_email != blank or settings.footer.contact_phone != blank or settings.footer.contact_address != blank %}
                <div class="space-y-2 font-sans text-xs text-slate-400">
                  {% if settings.footer.contact_email != blank %}
                    <div class="flex items-center gap-2">
                      <i class="fa-solid fa-envelope text-[var(--color-gold)] w-3"></i>
                      <a href="mailto:{{ settings.footer.contact_email }}" class="hover:text-[var(--color-gold-bright)] transition-colors">{{ settings.footer.contact_email }}</a>
                    </div>
                  {% endif %}
                  {% if settings.footer.contact_phone != blank %}
                    <div class="flex items-center gap-2">
                      <i class="fa-solid fa-phone text-[var(--color-gold)] w-3"></i>
                      <a href="tel:{{ settings.footer.contact_phone }}" class="hover:text-[var(--color-gold-bright)] transition-colors">{{ settings.footer.contact_phone }}</a>
                    </div>
                  {% endif %}
                  {% if settings.footer.contact_address != blank %}
                    <div class="flex items-start gap-2">
                      <i class="fa-solid fa-location-dot text-[var(--color-gold)] w-3 mt-0.5"></i>
                      <span>{{ settings.footer.contact_address }}</span>
                    </div>
                  {% endif %}
                </div>
              {% endif %}
            </div>

            <!-- Col 2: HIZLI MENÜ -->
