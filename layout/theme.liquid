<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8">
    <script>
      // CRITICAL INSTANT PRELOADER CHECK & PREVIEW IFRAME DETECTION
      const isThemePreview = window.location.search.includes('preview_theme_id') || 
                             window.location.search.includes('preview_ts') || 
                             (window.self !== window.top);

      if (isThemePreview) {
        document.documentElement.classList.add('is-theme-preview');
      } else if (sessionStorage.getItem('rpg_progress') || !sessionStorage.getItem('rpg_initial_visited')) {
        document.documentElement.classList.add('rpg-is-preloading');
      }
    </script>
    <style>
      /* Zero Page Flash Critical Rules */
      html.rpg-is-preloading:not(.is-theme-preview) body {
        overflow: hidden !important;
      }
      html.rpg-is-preloading:not(.is-theme-preview) #rpg-page-preloader,
      #rpg-page-preloader:not(.preloader-hidden):not(.is-theme-preview) {
        position: fixed !important;
        inset: 0 !important;
        z-index: 999999 !important;
        display: flex !important;
        opacity: 1 !important;
        visibility: visible !important;
        pointer-events: auto !important;
        background-color: #090705 !important;
        transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.6s !important;
      }
      html.rpg-is-preloading:not(.is-theme-preview) #rpg-preloader-curtain,
      #rpg-page-preloader:not(.preloader-hidden):not(.is-theme-preview) #rpg-preloader-curtain {
        transform: translateY(0%) !important;
        transition: transform 0.65s cubic-bezier(0.4, 0, 0.2, 1) !important;
      }
      #rpg-preloader-content {
        transition: transform 0.5s ease-out, opacity 0.5s ease-out !important;
        transform: scale(1) !important;
        opacity: 1 !important;
      }
      html:not(.rpg-is-preloading) #rpg-page-preloader.preloader-hidden,
      html.is-theme-preview #rpg-page-preloader {
        display: none !important;
        opacity: 0 !important;
        visibility: hidden !important;
        pointer-events: none !important;
      }
      html:not(.rpg-is-preloading) #rpg-page-preloader.preloader-hidden #rpg-preloader-curtain {
        transform: translateY(-100%) !important;
      }
      html:not(.rpg-is-preloading) #rpg-page-preloader.preloader-hidden #rpg-preloader-content {
        transform: scale(1.06) !important;
        opacity: 0 !important;
      }

      /* Dynamic Theme Root Design Tokens (Settings Schema Synchronization) */
      :root {
        --color-gold: {{ settings.colors.gold | default: '#d4af37' }};
        --color-gold-bright: {{ settings.colors.gold_bright | default: '#f5d061' }};
        --color-gold-dark: {{ settings.colors.gold_dark | default: '#8a6d1c' }};
        --color-gold-glow: rgba(212, 175, 55, 0.45);
        
        --color-realm-bg: {{ settings.colors.dark_bg | default: '#0c0907' }};
        --color-realm-surface: {{ settings.colors.surface | default: '#14100c' }};
        --color-realm-card: {{ settings.colors.card_bg | default: '#191410' }};
        --color-realm-card-hover: {{ settings.colors.card_hover | default: '#221b15' }};
        --color-realm-border: {{ settings.colors.border | default: '#3d301d' }};
        --color-realm-border-accent: {{ settings.colors.border_accent | default: '#4a3821' }};
        
        --color-text-primary: {{ settings.colors.text_primary | default: '#f8fafc' }};
        --color-text-muted: {{ settings.colors.text_muted | default: '#94a3b8' }};
        --color-text-gold: {{ settings.colors.gold_bright | default: '#f5d061' }};
      }

      body {
        background-color: var(--color-realm-bg) !important;
        color: var(--color-text-primary) !important;
      }

      #nprogress .bar {
        background: var(--color-gold) !important;
        height: 3px !important;
      }
      #nprogress .peg {
        box-shadow: 0 0 10px var(--color-gold), 0 0 5px var(--color-gold) !important;
      }
      #nprogress .spinner {
        display: none !important;
      }
      @keyframes marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
    </style>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{ content_for_header }}

    <!-- Google Fonts: Cinzel, Cinzel Decorative, Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800;900&family=Cinzel+Decorative:wght@700;900&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              primary: 'var(--color-gold)',
              gold: {
                DEFAULT: 'var(--color-gold)',
                bright: 'var(--color-gold-bright)',
                dark: 'var(--color-gold-dark)',
                glow: 'var(--color-gold-glow)',
              },
              realm: {
                bg: 'var(--color-realm-bg)',
                surface: 'var(--color-realm-surface)',
                card: 'var(--color-realm-card)',
                hover: 'var(--color-realm-card-hover)',
                border: 'var(--color-realm-border)',
                'border-accent': 'var(--color-realm-border-accent)',
              },
              base: 'var(--color-realm-bg)',
            },
            fontFamily: {
              sans: ['Inter', 'sans-serif'],
              medieval: ['Cinzel', 'serif'],
              decorative: ['Cinzel Decorative', 'serif'],
              display: ['Cinzel Decorative', 'serif'],
            },
          },
        },
      };
    </script>

    <!-- Theme CSS -->
    <link rel="stylesheet" href="{{ 'assets/style.css' | asset_url }}">

    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- NProgress -->
    <link rel="stylesheet" href="https://unpkg.com/nprogress@0.2.0/nprogress.css">
    <script src="https://unpkg.com/nprogress@0.2.0/nprogress.js"></script>

    {% if settings.integrations.google_analytics_id != blank %}
      <!-- Global site tag (gtag.js) - Google Analytics -->
      <script async src="https://www.googletagmanager.com/gtag/js?id={{ settings.integrations.google_analytics_id }}"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', '{{ settings.integrations.google_analytics_id }}');
      </script>
    {% endif %}
  </head>

  <body class="bg-realm-bg text-slate-100 flex flex-col min-h-screen antialiased selection:bg-[var(--color-gold)] selection:text-black font-sans">
    <!-- EPIC MEDIEVAL PAGE TRANSITION PRELOADER (FIRST DOM ELEMENT IN BODY) -->
    <div
      id="rpg-page-preloader"
      class="fixed inset-0 z-[999999] flex flex-col items-center justify-center bg-realm-bg/98 backdrop-blur-md overflow-hidden"
    >
      <!-- Top-to-Bottom Sliding Curtain Backdrop -->
      <div
        id="rpg-preloader-curtain"
        class="absolute inset-0 bg-gradient-to-b from-realm-surface via-realm-bg to-realm-surface border-b-4 border-[var(--color-gold)]"
      ></div>

      <!-- Preloader Center Battle Content -->
      <div
        id="rpg-preloader-content"
        class="relative z-20 flex flex-col items-center justify-center p-6 text-center"
      >
        <!-- Direct Clashing Swords GIF (Natural Organic Free-Floating Blend) -->
        <div
          class="relative w-52 h-52 mb-2 flex items-center justify-center pointer-events-none"
          style="-webkit-mask-image: radial-gradient(circle at center, #000 40%, transparent 85%); mask-image: radial-gradient(circle at center, #000 40%, transparent 85%);"
        >
          <!-- Background Gold Aura Shadow -->
          <div class="absolute inset-6 rounded-full bg-gradient-to-r from-amber-500/35 via-yellow-400/45 to-amber-500/35 blur-3xl animate-pulse"></div>

          <img
            src="https://media3.giphy.com/media/v1.Y2lkPTc5MGI3NjExazU1dXYzbGtoNzR4dTJ2Z3R5emJvenM2ZGF0ZHJqcXdsanVlYnh1cCZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9cw/eLfmhEKnLIEp1joioO/giphy.gif"
            alt="Diyar Yükleniyor"
            class="relative z-10 w-full h-full object-contain mix-blend-screen filter contrast-150 brightness-110 drop-shadow-[0_0_35px_rgba(245,208,97,0.95)]"
          >
        </div>

        <!-- Realm Status Text -->
        <div class="font-medieval font-bold text-xs md:text-sm uppercase tracking-[0.3em] text-[var(--color-gold-bright)] mb-4 drop-shadow-md">
          DİYAR YÜKLENİYOR...
        </div>

        <!-- Glowing Gold Progress Bar Container -->
        <div class="w-64 sm:w-72 h-3 bg-realm-card border-2 border-[var(--color-gold)] rounded-sm overflow-hidden p-0.5 shadow-2xl">
          <div id="rpg-progress-bar-fill" class="h-full bg-gradient-to-r from-[var(--color-gold-dark)] via-[var(--color-gold-bright)] to-[#ffe596] rounded-sm shadow-[0_0_15px_var(--color-gold)] transition-all duration-300 ease-out" style="width: 0%;"></div>
        </div>
      </div>
    </div>

    {% unless template == 'auth' or template contains 'auth/' or template == 'errors/maintenance' %}
      <!-- FLOATING CENTERED GOLD FRAME NAVBAR -->
      <header
        id="site-navbar"
        class="fixed top-4 left-1/2 -translate-x-1/2 w-[94%] max-w-[1240px] z-50 transition-all duration-500 ease-in-out rpg-floating-nav rounded-sm px-6 py-3 flex items-center justify-between text-slate-100"
      >
        <!-- Mobile Menu Toggle -->
        <button class="md:hidden flex items-center p-2 rounded-sm bg-realm-card border border-realm-border text-gold-bright hover:bg-realm-hover transition-all" onclick="toggleMobileMenu()">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>

        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 hover:scale-105 transition-transform duration-300">
          {% assign default_logo = 'https://avatars.githubusercontent.com/u/3840546?s=280&v=4' %}
          <img
            src="{{ settings.logo_light | default: settings.logo_dark | default: settings.logo | default: default_logo }}"
            alt="{{ shop.name }}"
            class="object-contain filter drop-shadow-[0_4px_10px_rgba(212,175,55,0.4)]"
            style="width: {{ settings.logo_width | default: 150 }}px; max-height: 48px;"
          >
        </a>

        <!-- Center Navigation Links -->
        <nav class="hidden md:flex items-center gap-8 font-medieval tracking-widest uppercase text-xs">
          {% if settings.nav_links != blank %}
            {% for link in settings.nav_links %}
              {% assign is_active = false %}
              {% if link.url == '/' %}
                {% if request.path == '/' or request.path == blank %}{% assign is_active = true %}{% endif %}
              {% elsif request.path contains link.url %}
                {% assign is_active = true %}
              {% endif %}
              <a
                href="{{ link.url }}"
                class="font-bold transition-all relative group py-1.5 {% if is_active %}text-[var(--color-gold-bright)] drop-shadow-[0_0_8px_rgba(212,175,55,0.6)]{% else %}text-slate-300 hover:text-[var(--color-gold-bright)]{% endif %}"
                {% if link.new_tab %}target="_blank"{% endif %}
              >
                {{ link.title }}
                <span class="absolute bottom-0 left-0 w-full h-[2px] bg-gradient-to-r from-[var(--color-gold)] via-[var(--color-gold-bright)] to-[var(--color-gold)] transition-transform origin-left {% if is_active %}scale-x-100 shadow-[0_0_8px_var(--color-gold)]{% else %}scale-x-0 group-hover:scale-x-100{% endif %}"></span>
              </a>
            {% endfor %}
          {% else %}
            <a href="/" class="font-bold transition-all relative group py-1.5 {% if request.path == '/' or request.path == blank %}text-[var(--color-gold-bright)] drop-shadow-[0_0_8px_rgba(212,175,55,0.6)]{% else %}text-slate-300 hover:text-[var(--color-gold-bright)]{% endif %}">
              <span>ANASAYFA</span>
              <span class="absolute bottom-0 left-0 w-full h-[2px] bg-gradient-to-r from-[var(--color-gold)] via-[var(--color-gold-bright)] to-[var(--color-gold)] transition-transform origin-left {% if request.path == '/' or request.path == blank %}scale-x-100{% else %}scale-x-0 group-hover:scale-x-100{% endif %}"></span>
            </a>
            <a href="/store" class="font-bold transition-all relative group py-1.5 {% if request.path contains '/store' %}text-[var(--color-gold-bright)] drop-shadow-[0_0_8px_rgba(212,175,55,0.6)]{% else %}text-slate-300 hover:text-[var(--color-gold-bright)]{% endif %}">
              <span>MAĞAZA</span>
              <span class="absolute bottom-0 left-0 w-full h-[2px] bg-gradient-to-r from-[var(--color-gold)] via-[var(--color-gold-bright)] to-[var(--color-gold)] transition-transform origin-left {% if request.path contains '/store' %}scale-x-100{% else %}scale-x-0 group-hover:scale-x-100{% endif %}"></span>
            </a>
            <a href="/forum" class="font-bold transition-all relative group py-1.5 {% if request.path contains '/forum' %}text-[var(--color-gold-bright)] drop-shadow-[0_0_8px_rgba(212,175,55,0.6)]{% else %}text-slate-300 hover:text-[var(--color-gold-bright)]{% endif %}">
              <span>FORUM</span>
              <span class="absolute bottom-0 left-0 w-full h-[2px] bg-gradient-to-r from-[var(--color-gold)] via-[var(--color-gold-bright)] to-[var(--color-gold)] transition-transform origin-left {% if request.path contains '/forum' %}scale-x-100{% else %}scale-x-0 group-hover:scale-x-100{% endif %}"></span>
            </a>
            <a href="/help" class="font-bold transition-all relative group py-1.5 {% if request.path contains '/help' or request.path contains '/yardim' %}text-[var(--color-gold-bright)] drop-shadow-[0_0_8px_rgba(212,175,55,0.6)]{% else %}text-slate-300 hover:text-[var(--color-gold-bright)]{% endif %}">
              <span>YARDIM</span>
              <span class="absolute bottom-0 left-0 w-full h-[2px] bg-gradient-to-r from-[var(--color-gold)] via-[var(--color-gold-bright)] to-[var(--color-gold)] transition-transform origin-left {% if request.path contains '/help' or request.path contains '/yardim' %}scale-x-100{% else %}scale-x-0 group-hover:scale-x-100{% endif %}"></span>
            </a>
          {% endif %}
        </nav>

        <!-- Right: CTA Button & Cart -->
        <div class="flex items-center gap-3">
          <!-- Cart Button -->
          <a
            href="/cart"
            id="nav-cart-btn"
            class="relative w-10 h-10 transition-all flex items-center justify-center bg-realm-card hover:bg-realm-hover border border-[var(--color-gold)]/50 hover:border-[var(--color-gold-bright)] rounded-sm text-[var(--color-gold-bright)] shadow-md"
            title="Envanter / Sepet"
          >
            <i class="fa-solid fa-sack-dollar text-sm"></i>
            <span class="header-cart-badge hidden absolute -top-1.5 -right-1.5 w-5 h-5 bg-gradient-to-r from-red-600 to-amber-600 text-white text-[10px] font-black rounded-full flex items-center justify-center border border-amber-300 shadow-md">0</span>
          </a>

          {% if customer %}
            <!-- Desktop Profile Menu -->
            <div class="relative group hidden md:block py-2">
              <a href="/profile" class="flex items-center gap-2.5 bg-realm-card px-3.5 py-1.5 rounded-sm border border-realm-border hover:border-[var(--color-gold)]/50 transition-all">
                <img src="https://mc-heads.net/avatar/{{ customer.username }}/32" class="w-7 h-7 rounded-sm border border-[var(--color-gold)]/40" alt="">
                <span class="text-slate-100 font-medieval font-bold text-xs">{{ customer.username }}</span>
                <span id="nav-credit" class="flex items-center gap-1 px-2 py-0.5 bg-[var(--color-gold)]/20 text-[var(--color-gold-bright)] rounded-sm text-[11px] font-bold border border-[var(--color-gold)]/30">
                  <i class="fa-solid fa-coins text-[10px]"></i> {{ customer.balance | default: '0' }} ₺
                </span>
              </a>

              <!-- Dropdown -->
              <div class="absolute right-0 top-[100%] w-64 bg-realm-surface rounded-sm shadow-2xl border border-realm-border opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 text-slate-200 z-[100] mt-2">
                <div class="p-3.5 border-b border-realm-border bg-realm-card rounded-t-sm flex items-center gap-3">
                  <img src="https://mc-heads.net/avatar/{{ customer.username }}/48" class="w-10 h-10 rounded-sm border border-[var(--color-gold)]/40" alt="">
                  <div class="overflow-hidden">
                    <div class="font-medieval font-bold text-[var(--color-gold-bright)] text-sm truncate">{{ customer.username }}</div>
                    <div class="text-[11px] text-slate-400 truncate">{{ customer.email }}</div>
                  </div>
                </div>
                <div class="p-2 grid grid-cols-2 gap-1.5">
                  <a href="/wallet" class="p-2.5 rounded-sm bg-realm-card hover:bg-realm-hover text-center border border-realm-border text-xs font-medieval font-bold flex flex-col items-center gap-1"><i class="fa-solid fa-coins text-amber-400"></i> Kredi Yükle</a>
                  <a href="/chest" class="p-2.5 rounded-sm bg-realm-card hover:bg-realm-hover text-center border border-realm-border text-xs font-medieval font-bold flex flex-col items-center gap-1"><i class="fa-solid fa-box-open text-amber-500"></i> Sandık</a>
                  <a href="/profile" class="p-2.5 rounded-sm bg-realm-card hover:bg-realm-hover text-center border border-realm-border text-xs font-medieval font-bold flex flex-col items-center gap-1"><i class="fa-solid fa-user-shield text-amber-400"></i> Profil</a>
                  <a href="/profile/settings" class="p-2.5 rounded-sm bg-realm-card hover:bg-realm-hover text-center border border-realm-border text-xs font-medieval font-bold flex flex-col items-center gap-1"><i class="fa-solid fa-gear text-slate-400"></i> Ayarlar</a>
                  
                  {% if customer.role.permissions and customer.role.permissions.size > 0 %}
                    <a
                      href="https://app.crafter.net.tr/cms/auth?websiteId={{ customer.websiteId }}&accessToken={{ customer.access_token }}&refreshToken={{ customer.refresh_token }}"
                      target="_blank"
                      class="col-span-2 p-2.5 rounded-sm bg-gradient-to-r from-amber-950/80 via-amber-900/60 to-amber-950/80 hover:from-amber-900 hover:to-amber-900 text-[var(--color-gold-bright)] text-center border border-[var(--color-gold)]/70 text-xs font-medieval font-bold flex items-center justify-center gap-2 transition-all shadow-md uppercase tracking-wider"
                    >
                      <i class="fa-solid fa-crown text-amber-400"></i>
                      <span>YÖNETİM PANELİ</span>
                    </a>
                  {% endif %}
                </div>
                <div class="p-2 border-t border-realm-border">
                  <button onclick="logoutAccount()" class="w-full py-2 rounded-sm text-red-400 hover:bg-red-950/40 text-xs font-medieval font-bold flex items-center justify-center gap-2"><i class="fa-solid fa-right-from-bracket"></i> Çıkış Yap</button>
                </div>
              </div>
            </div>
          {% else %}
            <a
              href="/auth/sign-in"
              class="rpg-btn-sharp-gold px-5 py-2.5 rounded-sm text-xs font-medieval uppercase tracking-wider flex items-center gap-2 shadow-lg"
            >
              <i class="fa-solid fa-user-shield text-xs"></i>
              GİRİŞ YAP
            </a>
          {% endif %}
        </div>
      </header>

      <!-- Mobile Menu Overlay & Drawer -->
      <div id="mobile-menu-overlay" class="fixed inset-0 z-[60] bg-black/80 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300" onclick="toggleMobileMenu()"></div>
      <div id="mobile-menu-sidebar" class="fixed inset-y-0 left-0 z-[70] w-[85%] max-w-sm bg-realm-surface border-r border-realm-border transform -translate-x-full transition-transform duration-300 flex flex-col">
        <div class="flex items-center justify-between p-5 border-b border-realm-border bg-realm-card">
          <img src="{{ settings.logo_dark | default: settings.logo_light | default: default_logo }}" alt="{{ shop.name }}" class="object-contain max-h-10">
          <button onclick="toggleMobileMenu()" class="text-slate-400 p-2 rounded-sm bg-realm-bg border border-realm-border"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="flex flex-col p-4 font-medieval font-bold text-slate-300 gap-2">
          <a href="/" class="p-3 rounded-sm bg-realm-card border border-realm-border text-[var(--color-gold-bright)]">ANASAYFA</a>
          <a href="/store" class="p-3 rounded-sm hover:bg-realm-card">MAĞAZA</a>
          <a href="/forum" class="p-3 rounded-sm hover:bg-realm-card">FORUM</a>
          <a href="/help" class="p-3 rounded-sm hover:bg-realm-card">YARDIM</a>
          {% if customer and customer.role.permissions and customer.role.permissions.size > 0 %}
            <a
              href="https://app.crafter.net.tr/cms/auth?websiteId={{ customer.websiteId }}&accessToken={{ customer.access_token }}&refreshToken={{ customer.refresh_token }}"
              target="_blank"
              class="p-3 rounded-sm bg-amber-950/60 border border-[var(--color-gold)]/70 text-[var(--color-gold-bright)] flex items-center gap-2 uppercase tracking-wider text-xs"
            >
              <i class="fa-solid fa-crown text-amber-400"></i>
              <span>YÖNETİM PANELİ</span>
            </a>
          {% endif %}
        </div>
      </div>
    {% endunless %}

    <!-- Toast Container -->
    <div id="toast-container" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-[999999] flex flex-col items-center gap-2 pointer-events-none"></div>

    <script>
      // Smooth Navbar Scroll Background Animation
      function updateNavOnScroll() {
        const nav = document.getElementById('site-navbar');
        if (!nav) return;
        if (window.scrollY > 30) {
          nav.classList.add('bg-realm-surface', 'border-[var(--color-gold)]', 'shadow-[0_15px_35px_rgba(0,0,0,0.95)]', 'backdrop-blur-md');
          nav.classList.remove('bg-transparent');
        } else {
          nav.classList.remove('bg-realm-surface', 'border-[var(--color-gold)]', 'shadow-[0_15px_35px_rgba(0,0,0,0.95)]', 'backdrop-blur-md');
        }
      }

      window.addEventListener('scroll', updateNavOnScroll);
      document.addEventListener('DOMContentLoaded', updateNavOnScroll);

      function toggleMobileMenu() {
        const overlay = document.getElementById('mobile-menu-overlay');
        const sidebar = document.getElementById('mobile-menu-sidebar');
        const isClosed = sidebar.classList.contains('-translate-x-full');
        if (isClosed) {
          overlay.classList.remove('opacity-0', 'pointer-events-none');
          overlay.classList.add('opacity-100');
          sidebar.classList.remove('-translate-x-full');
        } else {
          overlay.classList.remove('opacity-100');
          overlay.classList.add('opacity-0', 'pointer-events-none');
          sidebar.classList.add('-translate-x-full');
        }
      }

      // Global Toast Notification Logic
      window.showToast = function(message, type = 'info') {
        let container = document.getElementById('toast-container');
        if (!container) {
          container = document.createElement('div');
          container.id = 'toast-container';
          container.className = 'fixed bottom-6 left-1/2 -translate-x-1/2 z-[999999] flex flex-col items-center gap-2 pointer-events-none';
          document.body.appendChild(container);
        }

        const toast = document.createElement('div');
        let styleClasses = 'bg-realm-card border-realm-border text-slate-200';
        let iconHtml = '<i class="fa-solid fa-circle-info text-blue-400 text-base"></i>';

        if (type === 'success') {
          styleClasses = 'bg-realm-card border-[var(--color-gold)] text-[var(--color-gold-bright)] shadow-[0_0_20px_rgba(212,175,55,0.25)]';
          iconHtml = '<i class="fa-solid fa-circle-check text-amber-400 text-base"></i>';
        } else if (type === 'error') {
          styleClasses = 'bg-red-950/95 border-red-800 text-red-200 shadow-[0_0_20px_rgba(220,38,38,0.3)]';
          iconHtml = '<i class="fa-solid fa-triangle-exclamation text-red-400 text-base"></i>';
        } else if (type === 'warning') {
          styleClasses = 'bg-amber-950/95 border-amber-800 text-amber-200 shadow-[0_0_20px_rgba(245,158,11,0.25)]';
          iconHtml = '<i class="fa-solid fa-triangle-exclamation text-amber-400 text-base"></i>';
        }

        toast.className = `pointer-events-auto px-5 py-3 rounded-sm shadow-2xl text-xs font-medieval font-bold transform transition-all duration-300 translate-y-6 opacity-0 flex items-center gap-3 border backdrop-blur-md max-w-md ${styleClasses}`;
        toast.innerHTML = `${iconHtml} <span>${message}</span>`;
        container.appendChild(toast);

        requestAnimationFrame(() => {
          toast.classList.remove('translate-y-6', 'opacity-0');
          toast.classList.add('translate-y-0', 'opacity-100');
        });

        setTimeout(() => {
          toast.classList.remove('translate-y-0', 'opacity-100');
          toast.classList.add('translate-y-6', 'opacity-0');
          setTimeout(() => toast.remove(), 300);
        }, 4000);
      };

      function copyIp(ip) {
        navigator.clipboard.writeText(ip);
        window.showToast('Sunucu parşömen adresi kopyalandı! Oyuna katılabilirsiniz.', 'success');
      }

      // Global Callback & URL Params Handler
      document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const accessToken = urlParams.get('accessToken');
        const refreshToken = urlParams.get('refreshToken');
        const discordStatus = urlParams.get('discord_status');
        const discordError = urlParams.get('discord_error');
        const discordUsername = urlParams.get('discord_username');
        const generalError = urlParams.get('error');

        // Only handle globally if NOT on auth/sign-in page (auth page handles its own step transitions)
        const isAuthPage = window.location.pathname.includes('/auth');

        if (accessToken) {
          try {
            localStorage.setItem('accessToken', accessToken);
            if (refreshToken) localStorage.setItem('refreshToken', refreshToken);
          } catch(e) {}
          if (!isAuthPage) {
            window.showToast('Giriş başarılı! Hoş geldiniz.', 'success');
            // Clean URL
            urlParams.delete('accessToken');
            urlParams.delete('refreshToken');
            const cleanUrl = window.location.pathname + (urlParams.toString() ? '?' + urlParams.toString() : '');
            window.history.replaceState({}, document.title, cleanUrl);
          }
        }

        if (discordStatus === 'connected' && !isAuthPage) {
          const uName = discordUsername ? decodeURIComponent(discordUsername) : '';
          window.showToast(uName ? `"${uName}" Discord hesabınız başarıyla bağlandı!` : 'Discord hesabınız başarıyla bağlandı!', 'success');
          urlParams.delete('discord_status');
          urlParams.delete('discord_username');
          const cleanUrl = window.location.pathname + (urlParams.toString() ? '?' + urlParams.toString() : '');
          window.history.replaceState({}, document.title, cleanUrl);
        }

        if (discordError && !isAuthPage) {
          if (discordError === 'NOT_LINKED') {
            const uName = discordUsername ? decodeURIComponent(discordUsername) : 'Discord';
            window.showToast(`"${uName}" Discord hesabı herhangi bir oyuncu hesabıyla eşleştirilmemiş. Lütfen önce giriş yapıp ayarlardan Discord'u bağlayın.`, 'error');
          } else if (discordError === 'ALREADY_LINKED_TO_ANOTHER_ACCOUNT') {
            window.showToast('Bu Discord hesabı zaten başka bir oyuncu hesabına bağlı!', 'error');
          } else if (discordError === 'USER_BANNED') {
            window.showToast('Hesabınız yasaklanmıştır.', 'error');
          } else {
            window.showToast(decodeURIComponent(discordError), 'error');
          }
          urlParams.delete('discord_error');
          urlParams.delete('discord_username');
          const cleanUrl = window.location.pathname + (urlParams.toString() ? '?' + urlParams.toString() : '');
          window.history.replaceState({}, document.title, cleanUrl);
        } else if (generalError && !isAuthPage) {
          window.showToast(decodeURIComponent(generalError), 'error');
          urlParams.delete('error');
          const cleanUrl = window.location.pathname + (urlParams.toString() ? '?' + urlParams.toString() : '');
          window.history.replaceState({}, document.title, cleanUrl);
        }
      });
    </script>

    <!-- MAIN CONTENT -->
