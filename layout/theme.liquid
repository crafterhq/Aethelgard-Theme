          <div class="pt-8 border-t border-realm-border flex flex-col md:flex-row items-center justify-between gap-4 font-sans text-[11px] text-slate-500">
            <p>{{ settings.footer.copyright | default: 'TÜM HAKLARI SAKLIDIR. © 2026' }}</p>
            <p>POWERED BY <a href="https://crafter.net.tr" target="_blank" class="text-[var(--color-gold-bright)] font-medieval font-bold hover:underline">CRAFTER CMS</a></p>
          </div>
        </div>
      </footer>
