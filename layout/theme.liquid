                  {% for link in settings.footer.support_links %}
                    <li><a href="{{ link.url | default: '#' }}" class="text-slate-400 hover:text-[var(--color-gold-bright)] transition-colors">{{ link.title }}</a></li>
                  {% endfor %}
                {% else %}
                  <li><a href="/help" class="text-slate-400 hover:text-[var(--color-gold-bright)] transition-colors">Sunucu Kuralları</a></li>
                  <li><a href="/help" class="text-slate-400 hover:text-[var(--color-gold-bright)] transition-colors">Hizmet Şartları</a></li>
                  <li><a href="/legal" class="text-slate-400 hover:text-[var(--color-gold-bright)] transition-colors">Gizlilik Politikası</a></li>
                {% endif %}
