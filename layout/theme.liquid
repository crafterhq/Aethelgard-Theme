<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8">
    <script>
      // Global Toast Notification System - Always Available
      window.showToast = function(message, type = 'info') {
        try {
          let container = document.getElementById('toast-container');
          if (!container) {
            container = document.createElement('div');
            container.id = 'toast-container';
            container.className = 'fixed bottom-6 left-1/2 -translate-x-1/2 z-[9999999] flex flex-col items-center gap-2 pointer-events-none w-[92%] max-w-md';
            (document.body || document.documentElement).appendChild(container);
          }

          const toast = document.createElement('div');
          let styleClasses = 'bg-realm-card border-realm-border text-slate-200 shadow-xl';
          let iconHtml = '<i class="fa-solid fa-circle-info text-blue-400 text-base"></i>';

          if (type === 'success') {
            styleClasses = 'bg-[#1a0808] border-[var(--color-gold)] text-[var(--color-gold-bright)] shadow-[0_0_25px_var(--color-gold-glow)]';
            iconHtml = '<i class="fa-solid fa-circle-check text-[var(--color-gold-bright)] text-base"></i>';
          } else if (type === 'error') {
            styleClasses = 'bg-red-950/95 border-red-700 text-red-200 shadow-[0_0_25px_rgba(220,38,38,0.4)]';
            iconHtml = '<i class="fa-solid fa-triangle-exclamation text-red-400 text-base"></i>';
          } else if (type === 'warning') {
            styleClasses = 'bg-rose-950/95 border-rose-700 text-rose-200 shadow-[0_0_25px_rgba(244,63,94,0.35)]';
            iconHtml = '<i class="fa-solid fa-triangle-exclamation text-rose-400 text-base"></i>';
          }

          toast.className = `pointer-events-auto px-5 py-3.5 rounded-sm shadow-2xl text-xs font-medieval font-bold transform transition-all duration-300 translate-y-6 opacity-0 flex items-center gap-3 border backdrop-blur-md w-full ${styleClasses}`;
          toast.innerHTML = `${iconHtml} <span class="leading-snug flex-1">${message}</span>`;
          container.appendChild(toast);

          requestAnimationFrame(() => {
            toast.classList.remove('translate-y-6', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');
          });

          setTimeout(() => {
            toast.classList.remove('translate-y-0', 'opacity-100');
            toast.classList.add('translate-y-6', 'opacity-0');
            setTimeout(() => toast.remove(), 300);
          }, 4000);
        } catch(e) {
          console.error('Toast error:', e);
        }
        return true;
      };

      // Global Minecraft Skin Fallback Handler (Default Steve)
      window.addEventListener('error', function(e) {
        const img = e.target;
        if (img && img.tagName === 'IMG') {
          const src = img.src || '';
          if (src.includes('mc-heads.net') || src.includes('mcheads.org') || src.includes('mc-heads')) {
            if (!img.dataset.hasFallenBack) {
              img.dataset.hasFallenBack = 'true';
              if (src.includes('api.mcheads.org')) {
                img.src = 'https://api.mcheads.org/avatar/steve/left/160';
              } else {
                const sizeMatch = src.match(/\/(\d+)(\.png)?$/);
                const size = sizeMatch ? sizeMatch[1] : '48';
                img.src = `https://mc-heads.net/avatar/MHF_Steve/${size}`;
              }
            }
          }
        }
      }, true);
    </script>
    <style>
      /* Hero Section Full Screen Alignment & No Separation */
      #MainContent:has(.hero-grand-medieval),
      #MainContent:has(#hero-section),
      .template-index #MainContent,
      body.page-home #MainContent {
        padding-top: 0 !important;
      }

      /* Non-blocking Preloader Styles */
      #rpg-page-preloader.preloader-hidden {
        opacity: 0 !important;
        visibility: hidden !important;
        pointer-events: none !important;
        transition: opacity 0.4s ease, visibility 0.4s ease !important;
      }
      #rpg-page-preloader {
        transition: opacity 0.4s ease, visibility 0.4s ease !important;
      }

      /* Dynamic Theme Root Design Tokens (Settings Schema Synchronization) */
      :root {
        --color-gold: {{ settings.colors.gold | default: settings.color_gold | default: '#dc2626' }};
        --color-gold-bright: {{ settings.colors.gold_bright | default: settings.color_gold_bright | default: '#ef4444' }};
        --color-gold-dark: {{ settings.colors.gold_dark | default: settings.color_gold_dark | default: '#991b1b' }};
        --color-gold-glow: {{ settings.colors.gold_glow | default: settings.color_gold_glow | default: 'rgba(220, 38, 38, 0.45)' }};
        
        --color-realm-bg: {{ settings.colors.dark_bg | default: settings.color_dark_bg | default: '#0c0606' }};
        --color-realm-surface: {{ settings.colors.surface | default: settings.color_surface | default: '#140a0a' }};
        --color-realm-card: {{ settings.colors.card_bg | default: settings.color_card_bg | default: '#1a0d0d' }};
        --color-realm-card-hover: {{ settings.colors.card_hover | default: settings.color_card_hover | default: '#241212' }};
        --color-realm-border: {{ settings.colors.border | default: settings.color_border | default: '#3f1717' }};
        --color-realm-border-accent: {{ settings.colors.border_accent | default: settings.color_border_accent | default: '#5e1e1e' }};
        
        --color-text-primary: {{ settings.colors.text_primary | default: settings.color_text_primary | default: '#f8fafc' }};
        --color-text-muted: {{ settings.colors.text_muted | default: settings.color_text_muted | default: '#94a3b8' }};
        --color-text-gold: {{ settings.colors.text_gold | default: settings.color_text_gold | default: settings.colors.gold_bright | default: '#ef4444' }};

        /* Navbar Tokens */
        --color-navbar-bg: {{ settings.colors.navbar_bg | default: settings.color_navbar_bg | default: settings.colors.surface | default: '#140a0a' }};
        --color-navbar-border: {{ settings.colors.navbar_border | default: settings.color_navbar_border | default: settings.colors.border_accent | default: '#5e1e1e' }};
        --color-navbar-text: {{ settings.colors.navbar_text | default: settings.color_navbar_text | default: '#cbd5e1' }};
        --color-navbar-text-active: {{ settings.colors.navbar_text_active | default: settings.color_navbar_text_active | default: settings.colors.gold_bright | default: '#ef4444' }};

        /* Button Tokens */
        --color-btn-primary-bg: {{ settings.colors.btn_primary_bg | default: settings.color_btn_primary_bg | default: settings.colors.gold | default: '#dc2626' }};
        --color-btn-primary-text: {{ settings.colors.btn_primary_text | default: settings.color_btn_primary_text | default: '#ffffff' }};
        --color-btn-secondary-bg: {{ settings.colors.btn_secondary_bg | default: settings.color_btn_secondary_bg | default: settings.colors.card_bg | default: '#1a0d0d' }};
        --color-btn-secondary-border: {{ settings.colors.btn_secondary_border | default: settings.color_btn_secondary_border | default: settings.colors.gold_dark | default: '#7f1d1d' }};
        --color-btn-secondary-text: {{ settings.colors.btn_secondary_text | default: settings.color_btn_secondary_text | default: '#fca5a5' }};

        /* Marquee Tokens */
        --color-marquee-bg: {{ settings.colors.marquee_bg | default: settings.color_marquee_bg | default: '#170a0a' }};
        --color-marquee-border: {{ settings.colors.marquee_border | default: settings.color_marquee_border | default: settings.colors.border_accent | default: '#5e1e1e' }};
        --color-marquee-text: {{ settings.colors.marquee_text | default: settings.color_marquee_text | default: '#fca5a5' }};

        /* Footer Tokens */
        --color-footer-bg: {{ settings.colors.footer_bg | default: settings.color_footer_bg | default: '#090404' }};
        --color-footer-border: {{ settings.colors.footer_border | default: settings.color_footer_border | default: settings.colors.border | default: '#3f1717' }};
        --color-footer-title: {{ settings.colors.footer_title | default: settings.color_footer_title | default: settings.colors.gold_bright | default: '#ef4444' }};
        --color-footer-text: {{ settings.colors.footer_text | default: settings.color_footer_text | default: settings.colors.text_muted | default: '#94a3b8' }};

        /* Badge Tokens */
        --color-badge-bg: {{ settings.colors.badge_bg | default: settings.color_badge_bg | default: '#7f1d1d' }};
        --color-badge-text: {{ settings.colors.badge_text | default: settings.color_badge_text | default: '#fee2e2' }};
        --color-badge-border: {{ settings.colors.badge_border | default: settings.color_badge_border | default: settings.colors.gold | default: '#dc2626' }};

        /* Preloader Tokens */
        --color-preloader-bg: {{ settings.colors.preloader_bg | default: settings.color_preloader_bg | default: settings.colors.dark_bg | default: '#0c0606' }};
        --color-preloader-bar: {{ settings.colors.preloader_bar | default: settings.color_preloader_bar | default: settings.colors.gold_bright | default: '#ef4444' }};
      }

      body {
        background-color: var(--color-realm-bg) !important;
        color: var(--color-text-primary) !important;
      }

      h1, h2, h3, h4, h5, h6 {
        color: var(--color-text-primary, #f8fafc);
      }

      #nprogress .bar {
        background: var(--color-gold) !important;
        height: 3px !important;
      }
      #nprogress .peg {
        box-shadow: 0 0 10px var(--color-gold), 0 0 5px var(--color-gold) !important;
      }
      #nprogress .spinner {
        display: none !important;
      }

      .rpg-floating-nav {
        background: rgba(18, 8, 8, 0.85) !important;
        backdrop-filter: blur(16px) !important;
        -webkit-backdrop-filter: blur(16px) !important;
        border: 1px solid rgba(220, 38, 38, 0.28) !important;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.08) !important;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
      }
      .rpg-floating-nav.nav-scrolled {
        background: rgba(12, 5, 5, 0.96) !important;
        border-color: rgba(220, 38, 38, 0.45) !important;
        box-shadow: 0 16px 45px rgba(0, 0, 0, 0.95), 0 0 20px rgba(220, 38, 38, 0.12) !important;
      }

      .rpg-flourish-divider {
        position: relative;
        width: 100%;
        height: 1px;
        background: linear-gradient(90deg, transparent 0%, var(--color-footer-border) 20%, var(--color-gold) 50%, var(--color-footer-border) 80%, transparent 100%);
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .rpg-flourish-diamond {
        width: 10px;
        height: 10px;
        background: var(--color-gold);
        transform: rotate(45deg);
        box-shadow: 0 0 10px var(--color-gold-glow);
      }

      /* RPG CORE COMPONENTS & BUTTONS (Always inlined to guarantee immediate red theme rendering) */
      .rpg-btn-sharp-gold {
        background: linear-gradient(135deg, var(--color-gold-bright, #ef4444) 0%, var(--color-gold, #dc2626) 50%, var(--color-gold-dark, #991b1b) 100%) !important;
        color: var(--color-btn-primary-text, #ffffff) !important;
        font-family: 'Cinzel', serif !important;
        font-weight: 800 !important;
        letter-spacing: 0.08em !important;
        border: 1px solid #fca5a5 !important;
        border-radius: 3px !important;
        box-shadow: 0 6px 20px var(--color-gold-glow, rgba(220, 38, 38, 0.45)), inset 0 1px 0 rgba(255, 255, 255, 0.4) !important;
        transition: all 0.25s ease !important;
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.7) !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }
      .rpg-btn-sharp-gold:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 28px rgba(220, 38, 38, 0.75), inset 0 1px 0 rgba(255, 255, 255, 0.6) !important;
        filter: brightness(1.15) !important;
      }

      .rpg-btn-sharp-outline {
        background: rgba(24, 10, 10, 0.85) !important;
        color: #ffffff !important;
        font-family: 'Cinzel', serif !important;
        font-weight: 700 !important;
        border: 1.5px solid var(--color-gold-bright, #ef4444) !important;
        border-radius: 3px !important;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.8), inset 0 0 14px rgba(220, 38, 38, 0.18) !important;
        transition: all 0.25s ease !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8) !important;
      }
      .rpg-btn-sharp-outline:hover {
        background: linear-gradient(135deg, rgba(45, 16, 16, 0.95) 0%, rgba(26, 10, 10, 0.95) 100%) !important;
        border-color: #fca5a5 !important;
        color: #ffffff !important;
        box-shadow: 0 6px 24px var(--color-gold-glow, rgba(220, 38, 38, 0.5)), inset 0 0 18px rgba(220, 38, 38, 0.3) !important;
        transform: translateY(-2px);
      }

      /* Global Icon Visibility & Color Guarantees (Prevents any black/invisible icons) */
      .rpg-btn-sharp-outline i,
      .rpg-btn-sharp-outline svg {
        color: var(--color-gold-bright, #ef4444) !important;
        fill: currentColor !important;
        transition: color 0.25s ease;
      }
      .rpg-btn-sharp-outline:hover i,
      .rpg-btn-sharp-outline:hover svg {
        color: #ffffff !important;
      }
      .rpg-btn-sharp-gold i,
      .rpg-btn-sharp-gold svg {
        color: #ffffff !important;
        fill: currentColor !important;
      }

      .text-gold-bright,
      .text-gold,
      .text-primary {
        color: var(--color-gold-bright, #ef4444) !important;
      }

      .text-gold-glow {
        color: var(--color-gold-bright, #ef4444) !important;
        text-shadow: 0 0 20px var(--color-gold-glow, rgba(220, 38, 38, 0.45)), 0 2px 4px rgba(0, 0, 0, 0.95) !important;
      }

      .text-gold-gradient {
        background: linear-gradient(135deg, #ffffff 0%, #fca5a5 35%, var(--color-gold-bright, #ef4444) 70%, var(--color-gold, #dc2626) 100%) !important;
        -webkit-background-clip: text !important;
        background-clip: text !important;
        -webkit-text-fill-color: transparent !important;
      }

      .rpg-sharp-plaque {
        background: linear-gradient(135deg, rgba(24, 10, 10, 0.97) 0%, rgba(36, 14, 14, 0.97) 50%, rgba(24, 10, 10, 0.97) 100%) !important;
        border: 2px solid var(--color-gold-bright, #ef4444) !important;
        border-radius: 4px !important;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.95), 0 0 30px var(--color-gold-glow, rgba(220, 38, 38, 0.45)), inset 0 0 25px rgba(0, 0, 0, 0.9) !important;
        backdrop-filter: blur(12px) !important;
      }
      .rpg-sharp-plaque p {
        color: #fecdd3 !important;
        text-shadow: 0 2px 8px rgba(0, 0, 0, 1), 0 0 12px rgba(0, 0, 0, 1) !important;
      }

      .rpg-sharp-card {
        background-color: var(--color-realm-surface, #140a0a) !important;
        border: 1px solid var(--color-realm-border, #3f1717) !important;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
      }
      .rpg-sharp-card:hover {
        border-color: var(--color-gold, #dc2626) !important;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.9), 0 0 20px var(--color-gold-glow, rgba(220, 38, 38, 0.45)) !important;
        transform: translateY(-3px);
      }

      .rpg-grand-board {
        background: linear-gradient(180deg, var(--color-realm-card, #1a0d0d) 0%, var(--color-realm-bg, #0c0606) 100%) !important;
        border: 2px solid var(--color-realm-border-accent, #5e1e1e) !important;
        position: relative !important;
        border-radius: 6px !important;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(220, 38, 38, 0.25), inset 0 0 40px rgba(0, 0, 0, 0.9) !important;
        padding: 48px 24px 28px 24px !important;
      }

      .rpg-grand-board-inner {
        background: radial-gradient(circle at 50% 50%, rgba(35, 12, 12, 0.6) 0%, rgba(12, 6, 6, 0.95) 100%) !important;
        border: 1px solid rgba(220, 38, 38, 0.25) !important;
        border-radius: 4px !important;
      }

      .rpg-board-title-badge {
        position: absolute !important;
        top: -22px !important;
        left: 50% !important;
        transform: translateX(-50%) !important;
        background: linear-gradient(180deg, #240c0c 0%, var(--color-realm-bg, #0c0606) 100%) !important;
        border: 2px solid var(--color-gold, #dc2626) !important;
        border-radius: 4px !important;
        padding: 8px 42px !important;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.95), 0 0 15px var(--color-gold-glow, rgba(220, 38, 38, 0.45)) !important;
      }

      @keyframes marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
    </style>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{ content_for_header }}

    <!-- Google Fonts: Cinzel, Cinzel Decorative, Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800;900&family=Cinzel+Decorative:wght@700;900&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              primary: 'var(--color-gold)',
              gold: {
                DEFAULT: 'var(--color-gold)',
                bright: 'var(--color-gold-bright)',
                dark: 'var(--color-gold-dark)',
                glow: 'var(--color-gold-glow)',
                50: '#fef2f2',
                100: '#fee2e2',
                200: '#fecaca',
                300: '#fca5a5',
                400: '#f87171',
                500: '#ef4444',
                600: '#dc2626',
                700: '#b91c1c',
                800: '#991b1b',
                900: '#7f1d1d',
                950: '#450a0a',
              },
              realm: {
                bg: 'var(--color-realm-bg)',
                surface: 'var(--color-realm-surface)',
                card: 'var(--color-realm-card)',
                hover: 'var(--color-realm-card-hover)',
                border: 'var(--color-realm-border)',
                'border-accent': 'var(--color-realm-border-accent)',
              },
              base: 'var(--color-realm-bg)',
            },
            fontFamily: {
              sans: ['Inter', 'sans-serif'],
              medieval: ['Cinzel', 'serif'],
              decorative: ['Cinzel Decorative', 'serif'],
              display: ['Cinzel Decorative', 'serif'],
            },
          },
        },
      };
    </script>

    <!-- Theme CSS (with cache buster) -->
    <link rel="stylesheet" href="{{ 'assets/style.css' | asset_url }}?v={{ 'now' | date: '%s%N' }}">

    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- NProgress -->
    <link rel="stylesheet" href="https://unpkg.com/nprogress@0.2.0/nprogress.css">
    <script src="https://unpkg.com/nprogress@0.2.0/nprogress.js"></script>

    <!-- Crafter CMS SDK -->
    <script src="https://cdn.jsdelivr.net/npm/@crafter-cms/sdk@1.0.1/dist/crafter.min.js"></script>
    <script>
      window.crafter = new Crafter();
    </script>

    {% if settings.integrations.google_analytics_id != blank %}
      <!-- Global site tag (gtag.js) - Google Analytics -->
      <script async src="https://www.googletagmanager.com/gtag/js?id={{ settings.integrations.google_analytics_id }}"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', '{{ settings.integrations.google_analytics_id }}');
      </script>
    {% endif %}
  </head>

  <body class="bg-realm-bg text-slate-100 flex flex-col min-h-screen antialiased selection:bg-[var(--color-gold)] selection:text-black font-sans">
    <!-- EPIC MEDIEVAL PAGE TRANSITION PRELOADER (FIRST DOM ELEMENT IN BODY) -->
    <div
      id="rpg-page-preloader"
      class="fixed inset-0 z-[999999] flex flex-col items-center justify-center bg-realm-bg/98 backdrop-blur-md overflow-hidden"
    >
      <!-- Top-to-Bottom Sliding Curtain Backdrop -->
      <div
        id="rpg-preloader-curtain"
        class="absolute inset-0 bg-gradient-to-b from-realm-surface via-realm-bg to-realm-surface border-b-4 border-[var(--color-gold)]"
      ></div>

      <!-- Preloader Center Battle Content -->
      <div
        id="rpg-preloader-content"
        class="relative z-20 flex flex-col items-center justify-center p-6 text-center"
      >
        <!-- Direct Clashing Swords GIF (Natural Organic Free-Floating Blend) -->
        <div
          class="relative w-52 h-52 mb-2 flex items-center justify-center pointer-events-none"
          style="-webkit-mask-image: radial-gradient(circle at center, #000 40%, transparent 85%); mask-image: radial-gradient(circle at center, #000 40%, transparent 85%);"
        >
          <!-- Background Crimson Aura Shadow -->
          <div class="absolute inset-6 rounded-full bg-gradient-to-r from-red-600/35 via-rose-500/45 to-red-600/35 blur-3xl animate-pulse"></div>

          <img
            src="https://media3.giphy.com/media/v1.Y2lkPTc5MGI3NjExazU1dXYzbGtoNzR4dTJ2Z3R5emJvenM2ZGF0ZHJqcXdsanVlYnh1cCZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9cw/eLfmhEKnLIEp1joioO/giphy.gif"
            alt="Diyar Yükleniyor"
            class="relative z-10 w-full h-full object-contain mix-blend-screen filter contrast-150 brightness-110 drop-shadow-[0_0_35px_rgba(239,68,68,0.95)]"
          >
        </div>

        <!-- Realm Status Text -->
        <div class="font-medieval font-bold text-xs md:text-sm uppercase tracking-[0.3em] text-[var(--color-gold-bright)] mb-4 drop-shadow-md">
          DİYAR YÜKLENİYOR...
        </div>

        <!-- Glowing Red Progress Bar Container -->
        <div class="w-64 sm:w-72 h-3 bg-realm-card border-2 border-[var(--color-gold)] rounded-sm overflow-hidden p-0.5 shadow-2xl">
          <div id="rpg-progress-bar-fill" class="h-full bg-gradient-to-r from-[var(--color-gold-dark)] via-[var(--color-gold-bright)] to-[var(--color-preloader-bar)] rounded-sm shadow-[0_0_15px_var(--color-gold)] transition-all duration-300 ease-out" style="width: 0%;"></div>
        </div>
      </div>
    </div>

    {% unless template == 'auth' or template contains 'auth/' or template == 'errors/maintenance' %}
      <!-- REVISED GOTHIC GLASS NAVBAR -->
      <header
        id="site-navbar"
        class="fixed top-3 left-1/2 -translate-x-1/2 w-[95%] max-w-[1280px] z-50 transition-all duration-300 rounded-sm px-4 sm:px-6 py-2.5 flex items-center justify-between text-slate-100 rpg-floating-nav"
      >
        <!-- Left: Mobile Toggle & Brand Logo -->
        <div class="flex items-center gap-2 sm:gap-3">
          <!-- Mobile Menu Toggle -->
          <button
            class="md:hidden flex items-center justify-center w-9 h-9 rounded-sm bg-black/40 border border-red-900/40 text-slate-300 hover:text-white hover:border-red-500/60 transition-all"
            onclick="toggleMobileMenu()"
            aria-label="Menüyü Aç"
          >
