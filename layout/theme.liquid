            <!-- Col 4: BAĞLANTILAR -->
            <div>
              <h3 class="font-medieval font-bold text-[var(--color-gold-bright)] mb-5 uppercase tracking-widest text-xs border-b border-realm-border pb-2">Bağlantılar</h3>
