                  {% if settings.footer.contact_address != blank %}
                    <div class="flex items-start gap-2">
                      <i class="fa-solid fa-location-dot text-[var(--color-gold)] w-3 mt-0.5"></i>
                      <span>{{ settings.footer.contact_address }}</span>
                    </div>
                  {% endif %}
                </div>
              {% endif %}
            </div>

            <!-- Col 2: HIZLI MENÜ -->
            <div>
              <h3 class="font-medieval font-bold mb-5 uppercase tracking-widest text-xs border-b pb-2" style="color: var(--color-footer-title); border-color: var(--color-footer-border);">Hızlı Menü</h3>
              <ul class="space-y-3 font-sans text-xs">
                {% if settings.footer.quick_links and settings.footer.quick_links.size > 0 %}
                  {% for link in settings.footer.quick_links %}
                    <li><a href="{{ link.url | default: '#' }}" class="hover:text-[var(--color-gold-bright)] transition-colors" style="color: var(--color-footer-text);">{{ link.title }}</a></li>
                  {% endfor %}
                {% else %}
                  <li><a href="/" class="hover:text-[var(--color-gold-bright)] transition-colors" style="color: var(--color-footer-text);">Anasayfa</a></li>
                  <li><a href="/store" class="hover:text-[var(--color-gold-bright)] transition-colors" style="color: var(--color-footer-text);">Mağaza</a></li>
                  <li><a href="/forum" class="hover:text-[var(--color-gold-bright)] transition-colors" style="color: var(--color-footer-text);">Forum</a></li>
                  <li><a href="/help" class="hover:text-[var(--color-gold-bright)] transition-colors" style="color: var(--color-footer-text);">Yardım</a></li>
                {% endif %}
              </ul>
            </div>

            <!-- Col 3: SOSYAL MEDYA -->
            <div>
              <h3 class="font-medieval font-bold mb-5 uppercase tracking-widest text-xs border-b pb-2" style="color: var(--color-footer-title); border-color: var(--color-footer-border);">Sosyal Medya</h3>
              <ul class="space-y-3 font-sans text-xs">
                {% if settings.discord_url != blank %}<li><a href="{{ settings.discord_url }}" target="_blank" class="hover:text-[#5865F2] transition-colors" style="color: var(--color-footer-text);"><i class="fa-brands fa-discord mr-2"></i> Discord</a></li>{% endif %}
                {% if settings.instagram_url != blank %}<li><a href="{{ settings.instagram_url }}" target="_blank" class="hover:text-[#E1306C] transition-colors" style="color: var(--color-footer-text);"><i class="fa-brands fa-instagram mr-2"></i> Instagram</a></li>{% endif %}
                {% if settings.youtube_url != blank %}<li><a href="{{ settings.youtube_url }}" target="_blank" class="hover:text-[#FF0000] transition-colors" style="color: var(--color-footer-text);"><i class="fa-brands fa-youtube mr-2"></i> YouTube</a></li>{% endif %}
                {% if settings.tiktok_url != blank %}<li><a href="{{ settings.tiktok_url }}" target="_blank" class="hover:text-white transition-colors" style="color: var(--color-footer-text);"><i class="fa-brands fa-tiktok mr-2"></i> TikTok</a></li>{% endif %}
                {% if settings.twitter_url != blank %}<li><a href="{{ settings.twitter_url }}" target="_blank" class="hover:text-white transition-colors" style="color: var(--color-footer-text);"><i class="fa-brands fa-x-twitter mr-2"></i> X (Twitter)</a></li>{% endif %}
                {% if settings.forum_url != blank %}<li><a href="{{ settings.forum_url }}" class="hover:text-[var(--color-gold-bright)] transition-colors" style="color: var(--color-footer-text);"><i class="fa-solid fa-comments mr-2"></i> Topluluk Forumu</a></li>{% endif %}
              </ul>
            </div>

            <!-- Col 4: BAĞLANTILAR -->
            <div>
              <h3 class="font-medieval font-bold mb-5 uppercase tracking-widest text-xs border-b pb-2" style="color: var(--color-footer-title); border-color: var(--color-footer-border);">Bağlantılar</h3>
              <ul class="space-y-3 font-sans text-xs">
                {% if settings.footer.support_links and settings.footer.support_links.size > 0 %}
                  {% for link in settings.footer.support_links %}
                    <li><a href="{{ link.url | default: '#' }}" class="hover:text-[var(--color-gold-bright)] transition-colors" style="color: var(--color-footer-text);">{{ link.title }}</a></li>
                  {% endfor %}
                {% else %}
                  <li><a href="/help" class="hover:text-[var(--color-gold-bright)] transition-colors" style="color: var(--color-footer-text);">Sunucu Kuralları</a></li>
                  <li><a href="/help" class="hover:text-[var(--color-gold-bright)] transition-colors" style="color: var(--color-footer-text);">Hizmet Şartları</a></li>
                  <li><a href="/legal" class="hover:text-[var(--color-gold-bright)] transition-colors" style="color: var(--color-footer-text);">Gizlilik Politikası</a></li>
                {% endif %}
              </ul>
            </div>
          </div>

          <div class="pt-8 border-t border-realm-border flex flex-col md:flex-row items-center justify-between gap-4 font-sans text-[11px] text-slate-500">
            <p>{{ settings.footer.copyright | default: 'TÜM HAKLARI SAKLIDIR. © 2026' }}</p>
            <p>POWERED BY <a href="https://crafter.net.tr" target="_blank" class="text-[var(--color-gold-bright)] font-medieval font-bold hover:underline">CRAFTER CMS</a></p>
          </div>
        </div>
      </footer>
    {% endunless %}

    <!-- Global Scripts -->
    <script>
      NProgress.configure({ showSpinner: false });
      NProgress.done();
      async function logoutAccount() {
        try {
          if (window.crafter?.auth) {
            await window.crafter.auth.logout();
          } else {
            await fetch('/api/storefront/v2/auth/logout', { method: 'POST' });
          }
        } catch (err) {}
        window.location.reload();
      }
      document.addEventListener('click', e => {
        const a = e.target.closest('a');
        if (a && a.href && !a.href.startsWith('#') && !a.target && a.host === window.location.host) {
          if (a.href !== window.location.href) NProgress.start();
        }
      });

      {% if settings.discord.guild_id != blank %}
      fetch('https://discord.com/api/guilds/{{ settings.discord.guild_id | default: '1256991995147190272' }}/widget.json')
        .then(res => res.json())
        .then(data => {
          if (data.presence_count !== undefined) {
            document.querySelectorAll('.discord-live-count').forEach(el => {
              const format = el.getAttribute('data-format') || '{count}';
              el.textContent = format.replace('{count}', data.presence_count);
            });
          }
        }).catch(e => {});
      {% endif %}

      const serverIp = '{{ settings.server_ip | default: "mc.hypixel.net" }}';
      if (serverIp) {
        async function fetchServerStatus() {
          try {
            const res = await fetch(`https://mcapi.tr/api/v1/status/${serverIp}`);
            if (res.ok) { const data = await res.json(); if (data.online && data.players) return data.players.online; }
          } catch (e) {}
          return null;
        }
        fetchServerStatus().then(online => {
          document.querySelectorAll('.server-online-count').forEach(el => {
            if (online !== null) el.textContent = online;
            else el.textContent = '18';
          });
        });
      }

      function updateGlobalCartBadge() {
        try {
          const cart = JSON.parse(localStorage.getItem('cart') || '[]');
          const count = cart.reduce((sum, item) => sum + (item.quantity || 1), 0);
          document.querySelectorAll('.header-cart-badge').forEach((el) => {
            el.innerText = count;
            if (count > 0) el.classList.remove('hidden');
            else el.classList.add('hidden');
          });
        } catch (e) {}
      }
      window.addToCart = function (product, quantity = 1) {
        try {
          const productId = product.id || product._id;
          if (!productId) return;
          let cart = JSON.parse(localStorage.getItem('cart') || '[]');
          const idx = cart.findIndex((i) => (i.id || i._id) === productId);
          if (idx !== -1) cart[idx].quantity += quantity;
          else { product.quantity = quantity; product.id = productId; cart.push(product); }
          localStorage.setItem('cart', JSON.stringify(cart));
          updateGlobalCartBadge();
          window.showToast?.('Ürün envanterinize eklendi!', 'success');
        } catch (e) {}
      };
      // Cookie Helper & Crafter CMS Auth Bridge
      window.getCrafterCookie = function(name) {
        try {
          const parts = (document.cookie || '').split(';');
          for (let i = 0; i < parts.length; i++) {
            const item = parts[i].trim();
            if (item.indexOf(name + '=') === 0) {
              return item.substring(name.length + 1);
            }
          }
        } catch (e) {}
        try {
          const ls = localStorage.getItem(name);
          if (ls) return ls;
        } catch (e) {}
        if (name === 'crafter_token' && window.crafter && typeof window.crafter.getToken === 'function') {
          return window.crafter.getToken() || '';
        }
        return '';
      };

      window.openCmsPanel = function(websiteId, e) {
        if (e) {
          if (e.preventDefault) e.preventDefault();
          if (e.stopPropagation) e.stopPropagation();
        }
        const token = window.getCrafterCookie('crafter_token');
        const refreshToken = window.getCrafterCookie('crafter_refresh_token');
        const wid = websiteId || '{{ customer.websiteId }}';
        const url = 'https://app.crafter.net.tr/cms/auth?websiteId=' + encodeURIComponent(wid) + '&accessToken=' + encodeURIComponent(token) + '&refreshToken=' + encodeURIComponent(refreshToken);
        window.open(url, '_blank');
        return false;
      };

      window.updateCmsAuthLinks = function() {
        const token = window.getCrafterCookie('crafter_token');
        const refreshToken = window.getCrafterCookie('crafter_refresh_token');
        document.querySelectorAll('a.cms-admin-link').forEach((link) => {
          const wid = link.getAttribute('data-website-id') || '{{ customer.websiteId }}';
          link.href = 'https://app.crafter.net.tr/cms/auth?websiteId=' + encodeURIComponent(wid) + '&accessToken=' + encodeURIComponent(token) + '&refreshToken=' + encodeURIComponent(refreshToken);
        });
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', window.updateCmsAuthLinks);
      } else {
        window.updateCmsAuthLinks();
      }

      // Reactive Crafter SDK Event Bus Listeners
      if (window.crafter) {
        async function syncHeaderBalance() {
          try {
            {% if customer %}
            const data = await window.crafter.users.getBalance('me');
            if (data && data.balance !== undefined) {
              document.querySelectorAll('#nav-credit, .header-balance').forEach(el => {
                el.innerHTML = `<i class="fa-solid fa-coins text-[10px]"></i> ${data.balance} ${data.currency || '₺'}`;
              });
            }
            {% endif %}
          } catch (e) {}
        }

        window.crafter.on('cart:purchased', async (order) => {
          localStorage.removeItem('cart');
          updateGlobalCartBadge();
          await syncHeaderBalance();
        });

        window.crafter.on('balance:sent', async () => {
          await syncHeaderBalance();
        });

        window.crafter.on('redeem:used', async (res) => {
          if (res?.bonus) {
            await syncHeaderBalance();
          }
        });

        window.crafter.on('auth:logout', () => {
          window.location.reload();
        });

        window.crafter.on('2fa:enabled', (data) => {
          window.showToast?.(`İki aşamalı doğrulama (${data?.method || '2FA'}) aktifleştirildi.`, 'success');
        });

        window.crafter.on('2fa:disabled', () => {
          window.showToast?.('İki aşamalı doğrulama devre dışı bırakıldı.', 'info');
        });

        window.crafter.on('discord:unlinked', () => {
          window.showToast?.('Discord bağlantısı kaldırıldı.', 'info');
        });
      }
    </script>

    <script>
      // Lightweight & Non-blocking Preloader Management
      (function() {
        const preloader = document.getElementById('rpg-page-preloader');
        if (!preloader) return;

        function dismissPreloader() {
          document.documentElement.classList.remove('rpg-is-preloading');
          preloader.classList.add('preloader-hidden');
          setTimeout(() => {
            preloader.style.display = 'none';
          }, 400);
        }

        // Always dismiss quickly on page load
        if (document.readyState === 'complete' || document.readyState === 'interactive') {
          setTimeout(dismissPreloader, 150);
        } else {
          window.addEventListener('DOMContentLoaded', () => setTimeout(dismissPreloader, 150));
          window.addEventListener('load', dismissPreloader);
        }

        // Failsafe timer (never hang)
        setTimeout(dismissPreloader, 600);

        window.addEventListener('pageshow', (e) => {
          if (e.persisted) dismissPreloader();
        });

        // Clean any leftover progress states
        sessionStorage.removeItem('rpg_progress');
      })();
    </script>

    {% if settings.integrations.tawk_to_id != blank %}
      <!-- Start of Tawk.to Script -->
      <script type="text/javascript">
        var Tawk_API = Tawk_API || {},
          Tawk_LoadStart = new Date();
        (function () {
          var s1 = document.createElement('script'),
            s0 = document.getElementsByTagName('script')[0];
          s1.async = true;
          s1.src = 'https://embed.tawk.to/{{ settings.integrations.tawk_to_id }}';
          s1.charset = 'UTF-8';
          s1.setAttribute('crossorigin', '*');
          s0.parentNode.insertBefore(s1, s0);
        })();
      </script>
      <!-- End of Tawk.to Script -->
    {% endif %}
  </body>
</html>
