                {% if settings.youtube_url != blank %}<li><a href="{{ settings.youtube_url }}" target="_blank" class="text-slate-400 hover:text-[#FF0000] transition-colors"><i class="fa-brands fa-youtube mr-2"></i> YouTube</a></li>{% endif %}
                {% if settings.tiktok_url != blank %}<li><a href="{{ settings.tiktok_url }}" target="_blank" class="text-slate-400 hover:text-white transition-colors"><i class="fa-brands fa-tiktok mr-2"></i> TikTok</a></li>{% endif %}
                {% if settings.twitter_url != blank %}<li><a href="{{ settings.twitter_url }}" target="_blank" class="text-slate-400 hover:text-white transition-colors"><i class="fa-brands fa-x-twitter mr-2"></i> X (Twitter)</a></li>{% endif %}
