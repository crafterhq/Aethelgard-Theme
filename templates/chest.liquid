<div class="container max-w-[1400px] mx-auto px-4 mt-8 mb-24 space-y-8 min-h-[60vh] text-slate-100">
  <!-- Breadcrumb -->
  <div class="flex flex-wrap items-center gap-2 text-xs font-medieval font-bold text-slate-400 bg-realm-card py-2.5 px-5 rounded-sm w-fit border border-realm-border">
    <a href="/store" class="hover:text-gold-bright transition-colors flex items-center gap-2">
      <i class="fa-solid fa-store text-gold"></i>
      <span>MAĞAZA</span>
    </a>
    <span class="text-slate-600">/</span>
    <span class="text-slate-200">SANDIĞIM</span>
  </div>

  {% if customer %}
    {% assign total = chestItems.size %}
    {% assign used = 0 %}
    {% for item in chestItems %}
      {% if item.used %}
        {% assign used = used | plus: 1 %}
      {% endif %}
    {% endfor %}
    {% assign available = total | minus: used %}
    
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-8">
      <!-- LEFT: items container -->
      <div class="bg-realm-surface border-2 border-realm-border rounded-sm p-6 sm:p-8 h-fit shadow-2xl">
        <div class="flex items-center justify-between mb-8 pb-5 border-b border-realm-border">
          <h2 class="text-xl sm:text-2xl font-medieval font-black text-gold-bright flex items-center gap-3 uppercase tracking-wider drop-shadow-md">
            <i class="fa-solid fa-box-open text-gold-bright"></i>
            <span>EŞYALARIM</span>
          </h2>
          <span class="bg-realm-card border border-realm-border-accent text-gold-bright font-medieval font-bold px-3 py-1 rounded-sm text-xs uppercase tracking-widest">
            {{ total }} EŞYA
          </span>
        </div>

        {% if total == 0 %}
          <div id="chest-empty" class="text-center py-16">
            <div class="w-20 h-20 bg-realm-card border border-realm-border rounded-sm flex items-center justify-center mx-auto mb-6 text-gold-bright">
              <i class="fa-solid fa-box-archive text-3xl"></i>
            </div>
            <h3 class="text-2xl font-medieval font-black text-slate-100 mb-2 uppercase tracking-wider">SANDIĞINIZ BOŞ</h3>
            <p class="text-slate-400 font-medieval text-xs max-w-md mx-auto mb-8 leading-relaxed">
              Henüz hiç eşyanız yok. Mağazadan rütbe ve özel paketler satın alarak envanterinizi doldurmaya başlayın!
            </p>
            <a
              href="/store"
              class="rpg-btn-sharp-gold px-8 py-3.5 rounded-sm text-xs font-medieval font-bold uppercase tracking-widest inline-flex items-center gap-2 shadow-xl"
            >
              <i class="fa-solid fa-gem"></i>
              <span>MAĞAZAYA GİT</span>
            </a>
          </div>
        {% else %}
          <div id="chest-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for item in chestItems %}
              <div id="chest-item-{{ item.id }}" data-chest-item-id="{{ item.id }}" class="relative bg-realm-surface border border-realm-border hover:border-gold rounded-sm overflow-hidden transition-all duration-300 group flex flex-col h-full shadow-lg {% if item.used %}opacity-50 bg-realm-bg{% endif %}">
                {% if item.used %}
                  <div class="absolute top-3 left-3 z-10 bg-red-950/90 border border-red-800/80 text-red-300 text-[10px] font-medieval font-bold uppercase tracking-widest px-2.5 py-1 rounded-sm shadow-md">
                    KULLANILMIŞ
                  </div>
                {% endif %}

                <div class="w-full aspect-square bg-realm-bg flex items-center justify-center p-6 border-b border-realm-border relative">
                  <img
                    src="{{ item.product.image | default: 'https://via.placeholder.com/150?text=No+Image' }}"
                    alt="{{ item.product.name }}"
                    class="w-full h-full object-contain filter drop-shadow-md group-hover:scale-105 transition-transform duration-300 {% if item.used %}grayscale{% endif %}"
                  >
                </div>

                <div class="p-5 flex-1 flex flex-col">
                  <h3 class="chest-item-title text-base font-medieval font-black text-gold-bright mb-2 line-clamp-2 leading-tight uppercase tracking-wider group-hover:text-rose-200 transition-colors">
                    {{ item.product.name | default: 'Bilinmeyen Eşya' }}
                  </h3>
                  {% if item.product.description %}
                    <p class="chest-item-desc text-xs font-sans text-slate-300 line-clamp-2 mb-4 leading-relaxed" data-lexical="{{ item.product.description | json | escape }}">
                      {{ item.product.description | lexical_text }}
                    </p>
                  {% endif %}

                  <div class="mt-auto pt-4">
                    {% if item.used %}
                      <button
                        disabled
                        class="w-full bg-realm-card text-slate-500 font-medieval font-bold text-xs rounded-sm py-3 cursor-not-allowed border border-realm-border uppercase tracking-widest"
                      >
                        KULLANILMIŞ
                      </button>
                    {% else %}
                      <button
                        id="use-btn-{{ item.id }}"
                        onclick="useItem('{{ item.id }}', this)"
                        class="w-full bg-emerald-700 hover:bg-emerald-600 text-white font-medieval font-bold text-xs rounded-sm py-3 transition-colors shadow-lg border border-emerald-500/60 flex items-center justify-center gap-2 uppercase tracking-widest"
                      >
                        <i class="fa-solid fa-wand-magic-sparkles text-xs"></i>
                        <span>KULLAN</span>
                      </button>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <!-- RIGHT: statistics sidebar -->
      <div class="space-y-6">
        <div class="bg-realm-surface border-2 border-realm-border rounded-sm p-6 sticky top-24 shadow-2xl">
          <h2 class="text-base font-medieval font-black text-gold-bright mb-6 flex items-center gap-2 uppercase tracking-wider border-b border-realm-border pb-4">
            <i class="fa-solid fa-chart-pie text-gold-bright"></i>
            <span class="text-gold-bright">İSTATİSTİKLER</span>
          </h2>

          <div class="space-y-4 font-medieval">
            <!-- Total items -->
            <div class="bg-realm-card border border-red-900/60 rounded-sm p-4 flex items-center justify-between shadow-inner">
              <div>
                <p class="text-[10px] font-bold text-[var(--color-gold-bright)] uppercase tracking-widest mb-1">TOPLAM EŞYA</p>
                <p class="text-2xl font-black text-rose-300">{{ total }}</p>
              </div>
              <div class="w-11 h-11 bg-realm-bg border border-red-800/60 rounded-sm flex items-center justify-center text-[var(--color-gold-bright)]">
                <i class="fa-solid fa-boxes-stacked text-lg"></i>
              </div>
            </div>

            <!-- Available -->
            <div class="bg-realm-card border border-emerald-900/60 rounded-sm p-4 flex items-center justify-between shadow-inner">
              <div>
                <p class="text-[10px] font-bold text-emerald-500 uppercase tracking-widest mb-1">KULLANILABİLİR</p>
                <p id="stat-available" class="text-2xl font-black text-emerald-400">{{ available }}</p>
              </div>
              <div class="w-11 h-11 bg-realm-bg border border-emerald-800/60 rounded-sm flex items-center justify-center text-emerald-400">
                <i class="fa-solid fa-circle-check text-lg"></i>
              </div>
            </div>

            <!-- Used -->
            <div class="bg-realm-card border border-realm-border rounded-sm p-4 flex items-center justify-between shadow-inner">
              <div>
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">KULLANILMIŞ</p>
                <p id="stat-used" class="text-2xl font-black text-slate-300">{{ used }}</p>
              </div>
              <div class="w-11 h-11 bg-realm-bg border border-realm-border rounded-sm flex items-center justify-center text-slate-400">
                <i class="fa-solid fa-box text-lg"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <style>
      .chest-item-title,
      #chest-grid h3 {
        color: var(--color-gold-bright, #ef4444) !important;
      }
      .group:hover .chest-item-title,
      #chest-grid .group:hover h3 {
        color: #fecdd3 !important;
        text-shadow: 0 0 12px rgba(220, 38, 38, 0.45);
      }
    </style>

    <script>
      const customerId = '{{ customer.id | default: customer._id }}';
      let useTimeouts = {};

      // Safe Lexical parser for chest item descriptions
      function extractLexicalText(raw) {
        if (!raw) return '';
        let data = raw;
        if (typeof raw === 'string') {
          const trimmed = raw.trim();
          if (!trimmed.startsWith('{') && !trimmed.startsWith('[')) {
            return raw;
          }
          try {
            data = JSON.parse(raw);
          } catch (e) {
            return raw;
          }
        }

        if (typeof CrafterSDK !== 'undefined' && CrafterSDK.lexicalToPlainText) {
          try {
            const sdkRes = CrafterSDK.lexicalToPlainText(data);
            if (sdkRes) return sdkRes;
          } catch(e) {}
        }

        function traverse(node) {
          if (!node) return '';
          if (typeof node === 'string') return node;
          if (node.text) return node.text;
          if (Array.isArray(node.children)) {
            return node.children.map(traverse).filter(Boolean).join(' ');
          }
          if (node.root) {
            return traverse(node.root);
          }
          return '';
        }

        return traverse(data).trim();
      }

      function sanitizeChestDescriptions() {
        document.querySelectorAll('.chest-item-desc').forEach(el => {
          const currentText = el.textContent.trim();
          const raw = el.getAttribute('data-lexical');

          if (currentText === '[object Object]' || currentText.includes('[object') || !currentText) {
            if (raw) {
              try {
                const parsed = extractLexicalText(raw);
                if (parsed && parsed !== '[object Object]') {
                  el.textContent = parsed;
                  el.style.display = '';
                } else {
                  el.textContent = '';
                  el.style.display = 'none';
                }
              } catch (e) {
                el.textContent = '';
                el.style.display = 'none';
              }
            } else {
              el.textContent = '';
              el.style.display = 'none';
            }
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', sanitizeChestDescriptions);
      } else {
        sanitizeChestDescriptions();
      }

      // Reactive Event Bus Listener for chest item usage
      if (window.crafter) {
        window.crafter.on('chest:item_used', ({ itemId }) => {
          const itemCard = document.getElementById(`chest-item-${itemId}`) || document.querySelector(`[data-chest-item-id="${itemId}"]`);
          if (itemCard) {
            itemCard.classList.add('opacity-50', 'bg-realm-bg');
            const img = itemCard.querySelector('img');
            if (img) img.classList.add('grayscale');

            const btnContainer = itemCard.querySelector('.mt-auto.pt-4');
            if (btnContainer) {
              btnContainer.innerHTML = `
                <button disabled class="w-full bg-realm-card text-slate-500 font-medieval font-bold text-xs rounded-sm py-3 cursor-not-allowed border border-realm-border uppercase tracking-widest">
                  KULLANILMIŞ
                </button>
              `;
            }

            if (!itemCard.querySelector('.text-red-300')) {
              const badge = document.createElement('div');
              badge.className = 'absolute top-3 left-3 z-10 bg-red-950/90 border border-red-800/80 text-red-300 text-[10px] font-medieval font-bold uppercase tracking-widest px-2.5 py-1 rounded-sm shadow-md';
              badge.innerText = 'KULLANILMIŞ';
              itemCard.prepend(badge);
            }
          }

          // Update sidebar stats
          const statAvail = document.getElementById('stat-available');
          const statUsed = document.getElementById('stat-used');
          if (statAvail && statUsed) {
            const curAvail = parseInt(statAvail.innerText) || 0;
            const curUsed = parseInt(statUsed.innerText) || 0;
            statAvail.innerText = Math.max(0, curAvail - 1);
            statUsed.innerText = curUsed + 1;
          }
        });
      }

      async function useItem(itemId, btn) {
        if (!btn.classList.contains('confirm-mode')) {
          const ogText = btn.innerHTML;
          btn.dataset.ogText = ogText;
          btn.classList.add('confirm-mode', 'bg-red-700', 'hover:bg-red-600', 'border-red-500');
          btn.classList.remove('bg-emerald-700', 'hover:bg-emerald-600', 'border-emerald-500/60');
          btn.innerHTML = `<i class="fa-solid fa-triangle-exclamation"></i> <span>EMİN MİSİN?</span>`;

          useTimeouts[itemId] = setTimeout(() => {
            btn.classList.remove('confirm-mode', 'bg-red-700', 'hover:bg-red-600', 'border-red-500');
            btn.classList.add('bg-emerald-700', 'hover:bg-emerald-600', 'border-emerald-500/60');
            btn.innerHTML = btn.dataset.ogText;
          }, 3000);
          return;
        }

        clearTimeout(useTimeouts[itemId]);
        btn.disabled = true;
        btn.innerHTML = `<i class="fa-solid fa-spinner animate-spin"></i> <span>KULLANILIYOR...</span>`;

        try {
          await window.crafter.chest.useItem(itemId, customerId);
          window.showToast('Eşya başarıyla kullanıldı!', 'success');
        } catch (e) {
          window.showToast(e.message || 'Bir hata oluştu!', 'error');
          btn.disabled = false;
          btn.classList.remove('confirm-mode', 'bg-red-700', 'hover:bg-red-600', 'border-red-500');
          btn.classList.add('bg-emerald-700', 'hover:bg-emerald-600', 'border-emerald-500/60');
          btn.innerHTML = btn.dataset.ogText;
        }
      }
    </script>
  {% else %}
    <script>
      window.location.href = '/auth/sign-in?return=/chest';
    </script>
  {% endif %}
</div>