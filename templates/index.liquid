<!-- HOMEPAGE LAYOUT -->

<!-- FULL SCREEN (100VH) GRAND MEDIEVAL HERO SECTION -->
<div class="relative min-h-screen w-full flex items-center justify-center pt-28 pb-20 overflow-hidden border-b-2 border-realm-border-accent">
  <!-- Background Dark Castle Imagery with Vignette Overlay -->
  <div
    class="absolute inset-0 bg-cover bg-center filter brightness-35 scale-105 transition-transform duration-1000"
    style="background-image: url('{% if settings.hero.background_image != blank %}{{ settings.hero.background_image }}{% elsif settings.header.banner != blank %}{{ settings.header.banner }}{% else %}https://images.unsplash.com/photo-1518709268805-4e9042af9f23?q=80&w=2000&auto=format&fit=crop{% endif %}');"
  ></div>
  <div class="absolute inset-0 bg-gradient-to-b from-[var(--color-realm-bg)]/95 via-[var(--color-realm-bg)]/75 to-[var(--color-realm-bg)]"></div>

  <div class="container max-w-[1240px] mx-auto px-4 relative z-20 text-center flex flex-col items-center justify-center">
    <!-- Heraldic Direct Crossed Swords Emblem -->
    <div class="flex items-center justify-center gap-5 mb-6">
      <span class="h-[2px] w-20 bg-gradient-to-r from-transparent via-[var(--color-gold)] to-[var(--color-gold-bright)]"></span>
      <i class="fa-solid fa-khanda text-3xl md:text-4xl text-[var(--color-gold-bright)] drop-shadow-[0_0_20px_rgba(212,175,55,0.9)]"></i>
      <span class="h-[2px] w-20 bg-gradient-to-l from-transparent via-[var(--color-gold)] to-[var(--color-gold-bright)]"></span>
    </div>

    <!-- 3-Piece Symmetrical Equal-Width Grid Badges -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6 w-full max-w-4xl mx-auto mb-8 items-stretch font-medieval">
      <!-- Left Badge: Aktif Savaşçı -->
      <div class="h-16 bg-gradient-to-r from-realm-card to-realm-surface border-2 border-[var(--color-gold)]/60 px-4 rounded-sm shadow-xl hover:border-[var(--color-gold-bright)] transition-all flex items-center justify-center gap-3.5">
        <div class="w-10 h-10 rounded-sm bg-[var(--color-gold)]/20 border border-[var(--color-gold)]/60 flex items-center justify-center text-amber-400 shrink-0">
          <i class="fa-solid fa-shield-cat text-lg"></i>
        </div>
        <div class="text-left flex flex-col justify-center">
          <div class="text-[10px] text-slate-400 uppercase tracking-widest leading-none mb-1">AKTİF SAVAŞÇI</div>
          <div class="text-sm font-black text-[var(--color-gold-bright)] leading-none">
            <span class="server-online-count">18</span> ÇEVRİMİÇİ
          </div>
        </div>
      </div>

      <!-- Center Hero Button: Glowing IP Copy -->
      <button
        onclick="copyIp('{{ settings.server_ip | default: 'mc.hypixel.net' }}')"
        class="group h-16 bg-gradient-to-r from-[var(--color-gold-bright)] via-[var(--color-gold)] to-[var(--color-gold-dark)] text-[#090705] px-4 rounded-sm font-medieval font-black text-xs hover:brightness-110 transition-all cursor-pointer shadow-[0_0_25px_rgba(212,175,55,0.5)] border-2 border-gold-bright flex items-center justify-center gap-3"
        title="Sunucu IP Adresini Kopyala"
      >
        <i class="fa-solid fa-copy text-lg group-hover:scale-110 transition-transform shrink-0"></i>
        <div class="flex flex-col text-left justify-center min-w-0">
          <span class="text-[9px] uppercase font-sans tracking-widest text-[#2e2107] font-extrabold leading-none mb-1 truncate"
            >SUNUCU ADRESİ (TIKLA KOPYALA)</span
          >
          <span class="text-sm tracking-widest uppercase font-black text-[#090705] leading-none truncate">
            {{- settings.server_ip | default: 'mc.hypixel.net' -}}
          </span>
        </div>
      </button>

      <!-- Right Badge: Discord Loncası -->
      <div class="h-16 bg-gradient-to-r from-realm-surface to-realm-card border-2 border-[var(--color-gold)]/60 px-4 rounded-sm shadow-xl hover:border-[var(--color-gold-bright)] transition-all flex items-center justify-center gap-3.5">
        <div class="w-10 h-10 rounded-sm bg-[var(--color-gold)]/20 border border-[var(--color-gold)]/60 flex items-center justify-center text-amber-400 shrink-0">
          <i class="fa-brands fa-discord text-lg"></i>
        </div>
        <div class="text-left flex flex-col justify-center">
          <div class="text-[10px] text-slate-400 uppercase tracking-widest leading-none mb-1">DİSCORD LONCASI</div>
          <div class="text-sm font-black text-[var(--color-gold-bright)] leading-none">
            <span id="discord-online-count">--</span> ÇEVRİMİÇİ
          </div>
        </div>
      </div>
    </div>

    <!-- Giant Epic Hero Title -->
    <h1 class="animate-hero-slide text-3xl sm:text-5xl md:text-6xl font-medieval font-black text-slate-100 mb-6 tracking-wider uppercase leading-tight drop-shadow-[0_10px_25px_rgba(0,0,0,0.95)]">
      {{
        settings.home.hero_title
        | default: 'BU BÜYÜLÜ DÜNYADA <span class="text-gold-gradient block sm:inline drop-shadow-[0_0_30px_rgba(212,175,55,0.85)]">KENDİ EFSANENİ YAZ</span>'
      }}
    </h1>

    <!-- Subtitle Text Plaque -->
    <div class="rpg-sharp-plaque my-4 px-8 md:px-12 py-6 rounded-sm w-full max-w-3xl border-2 border-[var(--color-gold-bright)] shadow-[0_15px_45px_rgba(0,0,0,0.95),0_0_30px_rgba(212,175,55,0.4)]">
      <p class="text-base md:text-lg font-medieval font-bold !text-white leading-relaxed tracking-wide text-center drop-shadow-[0_2px_10px_rgba(0,0,0,1)]">
        <i class="fa-solid fa-quote-left text-[var(--color-gold-bright)] text-xs mr-2 opacity-80"></i>
        {{
          settings.home.hero_description
          | default: 'Bu büyülü dünyada unutulmaz bir macera seni bekliyor. Loncanı kur, ticaretini geliştir ve krallığın en güçlü oyuncuları arasında yerini al.'
        }}
        <i class="fa-solid fa-quote-right text-[var(--color-gold-bright)] text-xs ml-2 opacity-80"></i>
      </p>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-wrap items-center justify-center gap-5 mt-6 mb-4 w-full">
      <a
        href="{{ settings.home.hero_btn1_url | default: settings.discord_url | default: '#' }}"
        target="_blank"
        class="h-14 px-10 min-w-[220px] bg-gradient-to-r from-[var(--color-gold-bright)] via-[var(--color-gold)] to-[var(--color-gold-dark)] text-[#090705] font-medieval font-black text-sm uppercase tracking-widest rounded-sm border-2 border-gold-bright shadow-[0_0_25px_rgba(212,175,55,0.5)] hover:brightness-110 transition-all flex items-center justify-center gap-3 cursor-pointer"
      >
        <i class="fa-brands fa-discord text-lg"></i>
        <span>{{ settings.home.hero_btn1_text | default: "DISCORD'A KATIL" }}</span>
      </a>

      <a
        href="{{ settings.home.hero_btn2_url | default: '/store' }}"
        class="h-14 px-10 min-w-[220px] bg-realm-card text-[var(--color-gold-bright)] font-medieval font-bold text-sm uppercase tracking-widest rounded-sm border-2 border-[var(--color-gold-bright)] shadow-xl hover:bg-[var(--color-gold)]/20 hover:text-white transition-all flex items-center justify-center gap-2 cursor-pointer"
      >
        <i class="fa-solid fa-store text-base"></i>
        <span>{{ settings.home.hero_btn2_text | default: 'MAĞAZAYI KEŞFET' }}</span>
      </a>
    </div>

    <!-- Animated Bouncing Scroll Down Indicator -->
    <div class="w-full flex justify-center mt-12">
      <button
        type="button"
        onclick="document.getElementById('MainContentSection')?.scrollIntoView({ behavior: 'smooth' })"
        class="flex flex-col items-center gap-1.5 text-[var(--color-gold-bright)] hover:text-white transition-colors cursor-pointer group animate-bounce border-none bg-transparent"
        title="Aşağı Kaydır"
      >
        <span class="text-[10px] font-medieval uppercase tracking-[0.25em] text-slate-400 group-hover:text-[var(--color-gold-bright)] font-bold"
          >AŞAĞI KAYDIR</span
        >
        <div class="w-8 h-8 rounded-sm bg-realm-card/95 border border-[var(--color-gold)] flex items-center justify-center shadow-lg group-hover:border-white transition-colors">
          <i class="fa-solid fa-chevron-down text-xs text-[var(--color-gold-bright)]"></i>
        </div>
      </button>
    </div>
  </div>
</div>

<!-- DYNAMIC MARQUEE TICKER STRIP -->
{% if settings.home.show_marquee != false %}
  <div class="bg-realm-surface border-y-2 border-realm-border py-3 shadow-2xl relative z-10">
    <div class="container max-w-[1240px] mx-auto px-4 flex items-center gap-4">
      <div class="shrink-0 bg-[var(--color-gold)]/20 border border-[var(--color-gold)] px-3 py-1 rounded-sm text-[var(--color-gold-bright)] font-medieval font-bold text-xs uppercase tracking-widest flex items-center gap-2 z-10 shadow-md">
        <i class="fa-solid fa-scroll text-amber-400 animate-pulse"></i>
        <span>DUYURU</span>
      </div>

      <div class="rpg-marquee-wrapper flex-1 overflow-hidden">
        <div class="rpg-marquee-track font-medieval text-xs text-slate-200 tracking-wider">
          {% if settings.header.promo_texts and settings.header.promo_texts.size > 0 %}
            {% for item in settings.header.promo_texts %}
              {% assign pText = item.text | default: item %}
              <span class="px-8 text-[var(--color-gold-bright)] inline-flex items-center gap-2">
                <i class="fa-solid fa-shield-halved text-amber-400"></i>
                <span>{{ pText }}</span>
              </span>
            {% endfor %}
            <!-- DUPLICATE FOR INFINITE LOOP -->
            {% for item in settings.header.promo_texts %}
              {% assign pText = item.text | default: item %}
              <span class="px-8 text-[var(--color-gold-bright)] inline-flex items-center gap-2">
                <i class="fa-solid fa-shield-halved text-amber-400"></i>
                <span>{{ pText }}</span>
              </span>
            {% endfor %}
          {% else %}
            <span class="px-8 text-[var(--color-gold-bright)] inline-flex items-center gap-2"
              ><i class="fa-solid fa-shield-halved text-amber-400"></i> Sunucumuz aktif! Hemen kayıt olarak maceraya başlayabilirsin.</span
            >
            <span class="px-8 text-slate-200 inline-flex items-center gap-2"
              ><i class="fa-solid fa-coins text-amber-400"></i> Mağazada yeni sezon açılışına özel %20 indirim fırsatını kaçırmayın!</span
            >
            <span class="px-8 text-[var(--color-gold-bright)] inline-flex items-center gap-2"
              ><i class="fa-brands fa-discord text-sky-400"></i> Discord sunucumuza katılarak özel çekilişlere ve etkinliklere katılabilirsiniz.</span
            >
            <span class="px-8 text-[var(--color-gold-bright)] inline-flex items-center gap-2"
              ><i class="fa-solid fa-shield-halved text-amber-400"></i> Sunucumuz aktif! Hemen kayıt olarak maceraya başlayabilirsin.</span
            >
            <span class="px-8 text-slate-200 inline-flex items-center gap-2"
              ><i class="fa-solid fa-coins text-amber-400"></i> Mağazada yeni sezon açılışına özel %20 indirim fırsatını kaçırmayın!</span
            >
            <span class="px-8 text-[var(--color-gold-bright)] inline-flex items-center gap-2"
              ><i class="fa-brands fa-discord text-sky-400"></i> Discord sunucumuza katılarak özel çekilişlere ve etkinliklere katılabilirsiniz.</span
            >
          {% endif %}
        </div>
      </div>
    </div>
  </div>
{% endif %}

<div id="MainContentSection" class="container max-w-[1240px] mx-auto px-4 mt-16 space-y-24">
  <!-- FEATURED SLIDER STRIP -->
  {% if settings.home.slider != blank and settings.home.slider.size > 0 %}
    <div class="bg-realm-surface border-2 border-realm-border rounded-sm shadow-2xl overflow-hidden relative" data-ax-feature>
      {% for slide in settings.home.slider %}
        <div
          class="grid grid-cols-1 lg:grid-cols-12 items-center"
          data-feature-slide
          {% unless forloop.first %}
            style="display:none"
          {% endunless %}
        >
          <div class="lg:col-span-7 h-64 sm:h-80 lg:h-96 relative overflow-hidden bg-realm-bg">
            {% if slide.image != blank %}
              <img
                src="{{ slide.image }}"
                alt="{{ slide.title | default: shop.name }}"
                class="w-full h-full object-cover filter brightness-90"
              >
            {% else %}
              <div class="w-full h-full bg-gradient-to-br from-[#1f1912] to-[var(--color-realm-bg)] flex items-center justify-center">
                <i class="fa-solid fa-dragon text-6xl text-amber-500/30"></i>
              </div>
            {% endif %}
            <div
              class="absolute inset-0 bg-gradient-to-t from-[var(--color-realm-surface)] via-transparent to-transparent lg:bg-gradient-to-r lg:from-transparent lg:to-[var(--color-realm-surface)]"
            ></div>
          </div>
          <div class="lg:col-span-5 p-6 sm:p-8 flex flex-col justify-center">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-sm bg-[var(--color-gold)]/20 border border-[var(--color-gold)]/60 text-[var(--color-gold-bright)] font-medieval font-bold text-[10px] uppercase tracking-widest w-max mb-4">
              <i class="fa-solid fa-star"></i>
              <span>{{ slide.badge | default: 'ÖNE ÇIKAN DUYURU' }}</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-medieval font-black text-slate-100 uppercase mb-4 leading-tight">
              {{ slide.title | default: settings.home.slide_fallback_title | default: 'Aethelgard Güncellemeleri ve Etkinlikler' }}
            </h2>
            <p class="text-xs sm:text-sm font-sans text-slate-400 leading-relaxed mb-6">
              {{
                slide.description
                | default: settings.home.slide_fallback_desc
                | default: 'Sunucuya eklenen yeni sistemler, dengelemeler ve özel etkinlik detayları burada.'
              }}
            </p>
            {% if slide.button_text != blank %}
              <div>
                <a
                  href="{{ slide.button_url | default: '/' }}"
                  class="rpg-btn-sharp-gold px-6 py-3 rounded-sm font-medieval font-bold text-xs uppercase tracking-widest inline-flex items-center gap-2"
                >
                  <span>{{ slide.button_text }}</span>
                  <i class="fa-solid fa-arrow-right text-xs"></i>
                </a>
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}

      {% if settings.home.slider.size > 1 %}
        <div class="absolute bottom-4 right-6 flex items-center gap-2 z-20">
          {% for d in settings.home.slider %}
            <button
              type="button"
              class="w-3 h-3 rounded-full bg-realm-border border border-[var(--color-gold)]/40 transition-all {% if forloop.first %}!bg-[var(--color-gold-bright)] w-6{% endif %}"
              data-feature-dot="{{ forloop.index0 }}"
              aria-label="Slayt {{ forloop.index }}"
            ></button>
          {% endfor %}
          <button
            type="button"
            class="ml-2 w-8 h-8 rounded-sm bg-realm-card border border-[var(--color-gold)] text-[var(--color-gold-bright)] flex items-center justify-center hover:bg-[var(--color-gold)] hover:text-[#090705] transition-colors"
            data-feature-next
            aria-label="Sonraki"
          >
            <i class="fa-solid fa-chevron-right text-xs"></i>
          </button>
        </div>
      {% endif %}
    </div>
  {% endif %}

  <!-- SECTION 1: "SON GELİŞMELER & DUYURULAR" (NEWS & UPDATES) -->
  <div>
    <div class="flex items-center justify-between pb-4 border-b-2 border-realm-border-accent mb-10">
      <h2 class="text-2xl md:text-3xl font-medieval font-bold text-[var(--color-gold-bright)] tracking-wider flex items-center gap-3 uppercase">
        <i class="fa-solid fa-scroll text-amber-400"></i>
        <span>{{ settings.home.news_title | default: 'SON GELİŞMELER & DUYURULAR' }}</span>
      </h2>
      <a
        href="/posts"
        class="text-xs font-medieval font-bold text-[var(--color-gold-bright)] hover:text-white transition-colors flex items-center gap-2 uppercase tracking-widest"
      >
        <span>TÜM YAZILARI GÖR</span>
        <i class="fa-solid fa-arrow-right text-xs"></i>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {% if posts.size > 0 %}
        {% for post in posts limit: 3 %}
          <a
            href="/posts/{{ post.slug }}"
            class="group rpg-sharp-card rounded-sm overflow-hidden flex flex-col h-full"
          >
            <div class="h-56 overflow-hidden relative border-b border-realm-border-accent">
              <img
                src="{% if post.featuredImage != blank %}{{ post.featuredImage }}{% else %}https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=2070&auto=format&fit=crop{% endif %}"
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 filter brightness-90"
                alt="{{ post.title }}"
              >
              <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-realm-bg)] via-transparent to-transparent"></div>

              <div class="absolute top-4 left-4 bg-realm-card/95 backdrop-blur-md px-3 py-1 rounded-sm text-[10px] font-medieval font-bold text-[var(--color-gold-bright)] border border-[var(--color-gold)]/40 uppercase tracking-widest">
                {% if post.type == 'update' -%}
                  GÜNCELLEME
                {%- elsif post.type == 'announcement' -%}
                  DUYURU
                {%- else -%}
                  HABER
                {%- endif %}
              </div>
            </div>

            <div class="p-6 flex flex-col flex-grow">
              <div class="text-[11px] font-medieval text-slate-400 mb-3 flex items-center gap-2">
                <span>{{ post.createdAt | date: '%d.%m.%Y' }}</span>
                <span>&bull;</span>
                <span><i class="fa-regular fa-eye mr-1"></i> {{ post.viewCount | default: 0 }}</span>
              </div>

              <h3 class="text-base font-medieval font-bold text-slate-100 leading-snug mb-3 group-hover:text-[var(--color-gold-bright)] transition-colors uppercase">
                {{ post.title }}
              </h3>

              <p class="text-xs text-slate-400 line-clamp-3 mb-6 font-sans leading-relaxed">
                {% if post.metaDescription != blank %}
                  {{ post.metaDescription }}
                {% else %}
                  {{ post.content | lexical_text | truncate: 110 | default: 'Detayları incelemek için tıklayın...' }}
                {% endif %}
              </p>

              <div class="mt-auto pt-4 border-t border-realm-border-accent flex items-center justify-between text-xs font-medieval font-bold text-[var(--color-gold-bright)] group-hover:translate-x-1 transition-transform">
                <span>DEVAMINI OKU</span>
                <i class="fa-solid fa-arrow-right text-xs"></i>
              </div>
            </div>
          </a>
        {% endfor %}
      {% else %}
        <div class="col-span-1 md:col-span-3 py-16 text-center text-slate-400 font-medieval bg-realm-card rounded-sm border border-dashed border-realm-border-accent">
          Henüz güncel bir gelişme bulunmuyor.
        </div>
      {% endif %}
    </div>
  </div>

  <!-- RECENTLY JOINED WARRIORS 3D PEDESTAL STRIP -->
  {% if settings.home.show_recent_signups != false %}
    <div>
      <div class="flex items-center justify-between pb-3 border-b-2 border-realm-border-accent mb-8">
        <h2 class="text-xl md:text-2xl font-medieval font-bold text-[var(--color-gold-bright)] tracking-wider flex items-center gap-3 uppercase">
          <i class="fa-solid fa-user-plus text-amber-400"></i>
          <span>{{ settings.home.recent_signups_title | default: 'DİYARA SON KATILAN SAVAŞÇILAR' }}</span>
        </h2>
        <span class="text-[10px] font-medieval font-bold text-slate-400 uppercase tracking-widest bg-realm-card px-3 py-1 rounded-sm border border-realm-border">
          SON 5 OYUNCU
        </span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
        {% if stats.latest.signups and stats.latest.signups.size > 0 %}
          {% for signup in stats.latest.signups limit: 5 %}
            <div class="bg-realm-surface border-2 border-realm-border hover:border-[var(--color-gold)] rounded-sm p-4 flex flex-col items-center text-center group transition-all shadow-xl relative overflow-hidden">
              <div class="absolute top-2 right-2 bg-emerald-950/90 text-emerald-300 border border-emerald-800 text-[9px] font-medieval font-bold px-2 py-0.5 rounded-sm uppercase tracking-wider">
                YENİ
              </div>

              <!-- 3D Full Body Minecraft Skin Avatar Render -->
              <div class="w-24 h-32 flex items-center justify-center my-2 relative">
                <div
                  class="absolute inset-0 bg-[var(--color-gold)]/10 rounded-full blur-md group-hover:bg-[var(--color-gold)]/25 transition-all"
                ></div>
                <img
                  src="https://api.mcheads.org/avatar/{{ signup.username }}/left/160"
                  alt="{{ signup.username }}"
                  class="h-full object-contain relative z-10 filter drop-shadow-[0_5px_10px_rgba(0,0,0,0.8)] group-hover:scale-110 transition-transform duration-500"
                  loading="lazy"
                >
              </div>

              <!-- Pedestal Divider -->
              <div class="w-full h-[1px] bg-gradient-to-r from-transparent via-[var(--color-gold)]/40 to-transparent mb-3"></div>

              <div class="font-medieval font-bold text-xs text-slate-100 group-hover:text-[var(--color-gold-bright)] transition-colors truncate w-full uppercase">
                {{ signup.username }}
              </div>
              <div class="text-[10px] font-medieval text-slate-400 mt-1 uppercase tracking-wider">SAVAŞÇI</div>
            </div>
          {% endfor %}
        {% else %}
          <div class="col-span-full py-10 text-center text-slate-500 font-medieval text-xs bg-realm-surface rounded-sm border border-dashed border-realm-border uppercase">
            HENÜZ YENİ SAVAŞÇI BULUNMUYOR.
          </div>
        {% endif %}
      </div>
    </div>
  {% endif %}

  <!-- SECTION 2: "DESTEKÇİLERİMİZ & DİYAR İSTATİSTİKLERİ" -->
  {% if settings.home.show_stats_board != false %}
    <div class="rpg-grand-board">
      <div class="rpg-board-title-badge">
        <h2 class="text-lg md:text-xl font-medieval font-bold text-[var(--color-gold-bright)] tracking-widest text-center uppercase">
          {{ settings.home.stats_title | default: 'AETHELGARD İSTATİSTİKLERİ VE DESTEKÇİLERİMİZ' }}
        </h2>
      </div>

      <!-- Quick Stats Metric Strip -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 p-6 border-b border-realm-border bg-realm-bg font-medieval text-center">
        <div class="p-3 bg-realm-card rounded-sm border border-realm-border">
          <div class="text-[10px] text-slate-400 uppercase tracking-widest mb-1">TOPLAM SAVAŞÇI</div>
          <div class="text-lg font-black text-[var(--color-gold-bright)]">{{ stats.totalUsers | default: 1 }}</div>
        </div>
        <div class="p-3 bg-realm-card rounded-sm border border-realm-border">
