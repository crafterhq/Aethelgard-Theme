<script>
  // Discord Online Count Fetcher
  document.addEventListener('DOMContentLoaded', async () => {
    const guildId = '{{ settings.discord.guild_id | default: "1256991995147190272" }}';
    const el = document.getElementById('discord-online-count');
    if (guildId && el) {
      try {
        const res = await fetch(`https://discord.com/api/guilds/${guildId}/widget.json`);
        if (res.ok) {
          const data = await res.json();
          if (typeof data.presence_count === 'number') {
            el.innerText = data.presence_count;
          }
        }
      } catch (err) {
        console.error('Discord online count fetch failed:', err);
      }
    }
  });

  // Featured Slider Logic
  (function () {
    const root = document.querySelector('[data-ax-feature]');
    if (!root) return;
    const slides = Array.from(root.querySelectorAll('[data-feature-slide]'));
    if (slides.length < 2) return;
    const dots = Array.from(root.querySelectorAll('[data-feature-dot]'));
    const nextBtn = root.querySelector('[data-feature-next]');
    let index = 0;
    let timer;

    function goTo(i) {
      index = (i + slides.length) % slides.length;
      slides.forEach((s, si) => {
        s.style.display = si === index ? 'grid' : 'none';
      });
      dots.forEach((d, di) => {
        if (di === index) {
          d.classList.add('!bg-[var(--color-gold-bright)]', 'w-6');
        } else {
          d.classList.remove('!bg-[var(--color-gold-bright)]', 'w-6');
        }
      });
    }
    function start() {
      clearInterval(timer);
      timer = setInterval(() => goTo(index + 1), 5600);
    }
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        goTo(Number(dot.getAttribute('data-feature-dot')));
        start();
      });
    });
    nextBtn?.addEventListener('click', () => {
      goTo(index + 1);
      start();
    });
    goTo(0);
    start();
  })();
</script>
