<div class="flex-grow flex items-center justify-center p-4 antialiased">
  <div class="max-w-2xl w-full bg-realm-surface border-2 border-realm-border rounded-sm p-8 md:p-12 shadow-sm text-center relative overflow-hidden">

    <!-- Decorative background -->
    <div class="absolute top-0 left-0 w-32 h-32 bg-gold/5 rounded-br-[100px] -ml-8 -mt-8 opacity-50"></div>
    <div class="absolute bottom-0 right-0 w-32 h-32 bg-gold/5 rounded-tl-[100px] -mr-8 -mb-8 opacity-50"></div>

    <div class="relative z-10">
      <div class="w-24 h-24 bg-realm-card text-gold rounded-sm border-2 border-realm-border flex items-center justify-center mx-auto mb-8 shadow-[0_0_30px_rgba(212,175,55,0.15)]">
        <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
      </div>

      <h1 class="text-4xl font-black text-slate-100 tracking-tight mb-4 font-medieval">
        {{ settings.maintenance.title | default: 'Bakım Çalışması' }}
      </h1>
      <p class="text-lg text-slate-400 font-medium mb-8 max-w-lg mx-auto">
        {{ settings.maintenance.description | default: 'Şu anda sistemlerimizde planlı bir bakım çalışması yürütülmektedir. Çok yakında geri döneceğiz. Anlayışınız için teşekkür ederiz.' }}
      </p>

      <div class="flex flex-col items-center gap-4 mt-4">
        <a href="/auth/sign-in" class="bg-realm-card hover:bg-realm-hover transition-colors rounded-sm border border-realm-border px-6 py-3 inline-block font-bold text-slate-400 text-sm font-medieval">
          {{ settings.maintenance.footer_text | default: 'Yetkiniz varsa giriş yapıp görüntüleyebilirsiniz' }}
        </a>
      </div>
    </div>
  </div>
</div>
