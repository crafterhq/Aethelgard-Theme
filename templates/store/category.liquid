<!-- STORE > CATEGORY -->
<div class="container max-w-[1240px] mx-auto px-4 pt-32 pb-24 space-y-10">
  
  <!-- Breadcrumb -->
  <div class="flex flex-wrap items-center gap-3 text-xs font-medieval font-bold text-slate-400 uppercase tracking-widest">
    <a href="/" class="hover:text-gold-bright transition-colors flex items-center gap-2">
      <i class="fa-solid fa-house text-gold"></i>
      <span>ANASAYFA</span>
    </a>
    <span class="text-gold-dark">&bull;</span>
    <a href="/store" class="hover:text-gold-bright transition-colors">MAĞAZA</a>
    <span class="text-gold-dark">&bull;</span>
    <a href="/store/{{ server.slug }}" class="hover:text-gold-bright transition-colors">
      {{ server.name | default: 'SUNUCU' }}
    </a>
    <span class="text-gold-dark">&bull;</span>
    <span class="text-gold-bright">{{ category.name | default: 'ÜRÜNLER' }}</span>
  </div>

  <!-- COMPARISON TABLE MODE (if category.type == 'listed_products') -->
  {% if category.type == 'listed_products' %}
    <div class="overflow-x-auto w-full pb-6">
      <div class="min-w-[800px]">
        <div class="grid gap-4 mb-6 items-stretch" style="grid-template-columns: 240px repeat({{ products.size }}, 1fr);">
          <div class="bg-realm-bg border border-realm-border p-5 flex flex-col justify-end">
            <div class="text-[10px] font-medieval text-gold-bright uppercase tracking-widest mb-1">KARŞILAŞTIRMA</div>
            <h3 class="text-xl font-medieval font-bold text-gold-bright uppercase tracking-wider">PAKET DETAYLARI</h3>
          </div>

          {% for product in products %}
            <div class="rpg-card-frame p-5 flex flex-col justify-between text-center relative {% if product.featured %}border-gold-bright{% endif %}">
              {% if product.discountValue and product.discountValue > 0 %}
                <span class="absolute top-2 left-2 z-10 bg-red-950 text-red-200 border border-red-800 text-[9px] font-medieval font-bold px-2 py-0.5">
                  -{{ product.discountValue }}{% if product.discountType == 'percentage' %}%{% else %}₺{% endif %}
                </span>
              {% endif %}

              <div class="flex flex-col items-center">
                <a href="/store/{{ server.slug }}/{{ category.slug }}/{{ product.slug }}" class="w-20 h-20 bg-realm-bg border border-realm-border flex items-center justify-center p-2 mb-3 hover:border-gold-bright transition-colors">
                  {% if product.images and product.images.size > 0 %}
                    <img src="{{ product.images[0] }}" alt="{{ product.name }}" class="w-full h-full object-contain">
                  {% elsif product.image %}
                    <img src="{{ product.image }}" alt="{{ product.name }}" class="w-full h-full object-contain">
                  {% else %}
                    <i class="fa-solid fa-shield-halved text-4xl text-red-600/40"></i>
                  {% endif %}
                </a>

                <a href="/store/{{ server.slug }}/{{ category.slug }}/{{ product.slug }}">
                  <h3 class="font-medieval font-bold text-base text-slate-100 hover:text-gold-bright transition-colors uppercase leading-tight mb-2">
                    {{ product.name }}
                  </h3>
                </a>
              </div>

              <div class="mt-4 pt-3 border-t border-realm-border flex flex-col items-center gap-3">
                <div class="text-2xl font-medieval font-bold text-gold-bright">₺{{ product.price }}</div>

                <button
                  data-product="{{ product | json | escape }}"
                  onclick="window.addToCart(JSON.parse(this.dataset.product))"
                  class="w-full rpg-btn rpg-btn-gold py-2 text-xs uppercase"
                >
                  SEPETE EKLE
                </button>
              </div>
            </div>
          {% endfor %}
        </div>

        {% if category.addons and category.addons.size > 0 %}
          <div class="bg-realm-bg border border-realm-border overflow-hidden shadow-2xl">
            {% for addon in category.addons %}
              <div>
                <div class="px-6 py-3 bg-realm-bg border-b border-realm-border">
                  <h4 class="font-medieval font-bold text-xs uppercase tracking-widest text-gold-bright flex items-center gap-2">
                    <i class="fa-solid fa-shield text-gold"></i>
                    <span>{{ addon.title }}</span>
                  </h4>
                </div>

                {% for feature in addon.features %}
                  <div
                    class="grid hover:bg-realm-surface transition-colors border-b border-realm-border/60 last:border-b-0 items-center"
                    style="grid-template-columns: 240px repeat({{ products.size }}, 1fr);"
                  >
                    <div class="px-6 py-3.5 flex items-center justify-between border-r border-realm-border">
                      <span class="text-xs font-medieval font-bold text-slate-200 uppercase tracking-wide">{{ feature.title }}</span>
                    </div>

                    {% for product in products %}
                      {% assign featVal = feature.productValues[product.id] %}
                      <div class="px-4 py-3.5 text-center flex items-center justify-center border-r border-realm-border last:border-r-0 text-xs font-medieval font-bold">
                        {% if featVal == true or featVal == 'true' or featVal == '1' %}
                          <div class="w-6 h-6 rounded-full bg-emerald-950/60 border border-emerald-700/80 flex items-center justify-center text-emerald-400">
                            <i class="fa-solid fa-check text-xs"></i>
                          </div>
                        {% elsif featVal == false or featVal == 'false' or featVal == '0' %}
                          <div class="w-6 h-6 rounded-full bg-red-950/40 border border-red-900/60 flex items-center justify-center text-red-500/70">
                            <i class="fa-solid fa-xmark text-xs"></i>
                          </div>
                        {% else %}
                          <span class="text-gold-bright font-bold">{{ featVal | default: '-' }}</span>
                        {% endif %}
                      </div>
                    {% endfor %}
                  </div>
                {% endfor %}
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>

  <!-- MAIN SHOP GRID & SIDEBAR LAYOUT -->
  {% else %}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- LEFT: main product list grid -->
      <div class="lg:col-span-8 space-y-8">
        
        <!-- Top Toolbar Header -->
        <div class="flex items-center justify-between text-xs font-medieval text-slate-400 pb-4 border-b border-realm-border">
          <div>
            <span>Toplam {{ products.size }} ürün listeleniyor</span>
          </div>

          <div class="flex items-center gap-2">
            <label for="shopSort" class="hidden sm:inline">Sıralama:</label>
            <select
              id="shopSort"
              class="bg-realm-bg border border-realm-border text-slate-200 text-xs font-medieval px-3 py-1.5 focus:outline-none focus:border-gold"
            >
              <option value="default">Varsayılan Sıralama</option>
              <option value="price-asc">Fiyat: Düşükten Yükseğe</option>
              <option value="price-desc">Fiyat: Yüksekten Düşüğe</option>
            </select>
          </div>
        </div>

        {% if products and products.size > 0 %}
          <!-- Product cards grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
            {% for product in products %}
              <div class="flex flex-col justify-between group">
                
                <!-- Product image frame -->
                <div class="relative w-full aspect-square bg-realm-bg border border-realm-border group-hover:border-gold p-6 flex items-center justify-center transition-all duration-300 shadow-lg mb-3">
                  {% if product.discountValue and product.discountValue > 0 %}
                    <span class="absolute top-2 left-2 z-10 bg-red-950 text-red-200 border border-red-800 text-[9px] font-medieval font-bold px-2 py-0.5">
                      -{{ product.discountValue }}{% if product.discountType == 'percentage' %}%{% else %}₺{% endif %}
                    </span>
                  {% endif %}

                  <a href="/store/{{ server.slug }}/{{ category.slug }}/{{ product.slug }}" class="w-full h-full flex items-center justify-center">
                    {% if product.images and product.images.size > 0 %}
                      <img src="{{ product.images[0] }}" alt="{{ product.name }}" class="w-full h-full object-contain filter drop-shadow group-hover:scale-105 transition-transform duration-500">
                    {% elsif product.image %}
                      <img src="{{ product.image }}" alt="{{ product.name }}" class="w-full h-full object-contain filter drop-shadow group-hover:scale-105 transition-transform duration-500">
                    {% else %}
                      <i class="fa-solid fa-shield-halved text-5xl text-slate-800"></i>
                    {% endif %}
                  </a>
                </div>

                <!-- Product title & price row -->
                <div class="space-y-1">
                  <div class="flex items-baseline justify-between gap-2">
                    <a href="/store/{{ server.slug }}/{{ category.slug }}/{{ product.slug }}" class="truncate">
                      <h3 class="text-sm font-medieval font-bold text-slate-100 group-hover:text-gold-bright transition-colors uppercase">
                        {{ product.name }}
                      </h3>
                    </a>
                    <div class="text-sm font-medieval font-bold text-gold-bright shrink-0">₺{{ product.price }}</div>
                  </div>

                  <p class="text-[11px] font-medieval text-slate-500 truncate">
                    {{ category.name | default: 'Paketler' }}
                  </p>
                </div>

                <!-- Add to cart button -->
                <button
                  data-product="{{ product | json | escape }}"
                  onclick="window.addToCart(JSON.parse(this.dataset.product))"
                  class="mt-3 w-full rpg-btn py-2 text-[10px] tracking-widest opacity-90 hover:opacity-100"
                >
                  SEPETE EKLE
                </button>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <div class="py-16 text-center text-slate-400 font-medieval bg-realm-bg border border-realm-border">
            Bu kategoride ürün bulunmuyor.
          </div>
        {% endif %}
      </div>

      <!-- RIGHT: sidebar widgets -->
      <div class="lg:col-span-4 space-y-8">
        
        <!-- Widget 1: in-store search -->
        <div class="bg-realm-bg border border-realm-border p-6 rounded-sm space-y-4">
          <h4 class="text-sm font-medieval font-bold text-slate-100 uppercase tracking-widest border-b border-realm-border pb-3">
            MAĞAZADA ARA
          </h4>
          <div class="relative">
            <input
              type="text"
              placeholder="Ürün ara..."
              class="w-full bg-realm-bg border border-realm-border text-xs font-medieval text-slate-200 px-4 py-2.5 pr-10 focus:outline-none focus:border-gold"
            >
            <i class="fa-solid fa-magnifying-glass absolute right-3 top-1/2 -translate-y-1/2 text-slate-500 text-xs"></i>
          </div>
        </div>

        <!-- Widget 2: price filter -->
        <div class="bg-realm-bg border border-realm-border p-6 rounded-sm space-y-4">
          <h4 class="text-sm font-medieval font-bold text-slate-100 uppercase tracking-widest border-b border-realm-border pb-3">
            FİYAT FİLTRESİ
          </h4>
          
          <div class="space-y-3">
            <input type="range" min="0" max="1000" value="500" class="w-full accent-gold">
            <div class="flex items-center justify-between text-xs font-medieval text-slate-400">
              <button class="rpg-btn py-1 px-4 text-[10px]">FİLTRELE</button>
              <span>Fiyat: ₺0 — ₺1000</span>
            </div>
          </div>
        </div>

        <!-- Widget 3: popular packages -->
        <div class="bg-realm-bg border border-realm-border p-6 rounded-sm space-y-4">
          <h4 class="text-sm font-medieval font-bold text-slate-100 uppercase tracking-widest border-b border-realm-border pb-3">
            EN POPÜLER PAKETLER
          </h4>

          <div class="space-y-4">
            {% for popProduct in products limit:3 %}
              <a href="/store/{{ server.slug }}/{{ category.slug }}/{{ popProduct.slug }}" class="flex items-center gap-3 group">
                <div class="w-14 h-14 bg-realm-bg border border-realm-border group-hover:border-gold p-1 shrink-0 flex items-center justify-center">
                  {% if popProduct.images and popProduct.images.size > 0 %}
                    <img src="{{ popProduct.images[0] }}" class="w-full h-full object-contain">
                  {% elsif popProduct.image %}
                    <img src="{{ popProduct.image }}" class="w-full h-full object-contain">
                  {% else %}
                    <i class="fa-solid fa-shield text-red-600/40"></i>
                  {% endif %}
                </div>

                <div>
                  <h5 class="text-xs font-medieval font-bold text-slate-200 group-hover:text-gold-bright transition-colors uppercase">
                    {{ popProduct.name }}
                  </h5>
                  <span class="text-xs font-medieval text-gold-bright font-bold">₺{{ popProduct.price }}</span>
                </div>
              </a>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  {% endif %}
</div>