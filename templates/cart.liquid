<div class="container max-w-[1400px] mx-auto px-4 mt-8 mb-24 space-y-8 min-h-[60vh] text-slate-100">
  <!-- Breadcrumb -->
  <div class="flex flex-wrap items-center gap-2 text-xs font-medieval font-bold text-slate-400 bg-realm-card py-2.5 px-5 rounded-sm w-fit border border-realm-border">
    <a href="/store" class="hover:text-gold-bright transition-colors flex items-center gap-2">
      <i class="fa-solid fa-store text-gold"></i>
      <span>MAĞAZA</span>
    </a>
    <span class="text-slate-600">/</span>
    <span class="text-slate-200">SEPETİM</span>
  </div>

  <!-- Loading State -->
  <div id="cart-loading" class="flex flex-col items-center justify-center py-24 bg-realm-surface border-2 border-realm-border rounded-sm shadow-2xl">
    <i class="fa-solid fa-circle-notch animate-spin text-4xl text-gold-bright mb-4"></i>
    <div class="font-medieval font-bold text-slate-400 uppercase tracking-widest text-sm">SEPETİNİZ YÜKLENİYOR...</div>
  </div>

  <!-- Empty State -->
  <div
    id="cart-empty"
    class="hidden bg-realm-surface border-2 border-realm-border rounded-sm p-16 text-center flex flex-col items-center shadow-2xl"
  >
    <div class="w-20 h-20 bg-realm-card border border-realm-border rounded-sm flex items-center justify-center mx-auto mb-6 text-gold-bright">
      <i class="fa-solid fa-cart-shopping text-3xl"></i>
    </div>
    <h3 class="text-2xl font-medieval font-black text-slate-100 mb-2 uppercase tracking-wider">SEPETİNİZ BOŞ</h3>
    <p class="text-slate-400 font-medieval text-xs max-w-md mb-8 leading-relaxed">
      Henüz sepetinize bir ürün eklemediniz. Mağazamızı keşfedin ve sunucudaki gücünüzü artıracak efsanevi eşyaları sepetinize ekleyin.
    </p>
    <a
      href="/store"
      class="rpg-btn-sharp-gold px-8 py-3.5 rounded-sm text-xs font-medieval font-bold uppercase tracking-widest flex items-center gap-2"
    >
      <i class="fa-solid fa-gem"></i>
      <span>MAĞAZAYA GİT</span>
    </a>
  </div>

  <!-- Cart Content -->
  <div id="cart-content" class="hidden grid grid-cols-1 lg:grid-cols-[1fr_400px] gap-8">
    <!-- Products List -->
    <div class="bg-realm-surface border-2 border-realm-border rounded-sm overflow-hidden h-fit shadow-2xl">
      <div class="p-5 border-b border-realm-border flex items-center justify-between bg-realm-card">
        <h2 class="text-base font-medieval font-black text-gold-bright uppercase tracking-wider flex items-center gap-2">
          <i class="fa-solid fa-basket-shopping text-gold-bright"></i>
          <span>SEPET ÜRÜNLERİ</span>
          <span class="text-slate-400 text-xs">(<span id="cart-count">0</span>)</span>
        </h2>
        <button
          id="clearCartBtn"
          onclick="clearCart(this)"
          class="text-xs font-medieval font-bold text-red-400 hover:text-red-300 transition-colors bg-[#1f1616] border border-red-900/50 hover:bg-red-950/60 px-3 py-1.5 rounded-sm flex items-center gap-1.5 uppercase"
        >
          <i class="fa-solid fa-trash-can"></i>
          <span>TEMİZLE</span>
        </button>
      </div>
      <div id="cart-items" class="divide-y divide-realm-border">
        <!-- JS rendered items -->
      </div>
    </div>

    <!-- Order Summary Sidebar -->
    <div class="space-y-6">
      <div class="bg-realm-surface border-2 border-realm-border rounded-sm p-6 sticky top-24 shadow-2xl">
        <h2 class="text-base font-medieval font-black text-gold-bright mb-6 flex items-center gap-2 uppercase tracking-wider border-b border-realm-border pb-4">
          <i class="fa-solid fa-receipt text-gold-bright"></i>
          <span class="text-gold-bright">SİPARİŞ ÖZETİ</span>
        </h2>

        <!-- Coupon Form -->
        <div class="mb-6 pb-6 border-b border-realm-border">
          <div
            id="applied-coupon"
            class="hidden mb-4 p-4 bg-realm-card border border-emerald-800/60 rounded-sm relative overflow-hidden"
          >
            <div class="flex items-center justify-between relative z-10">
              <div class="flex items-center gap-2">
                <i class="fa-solid fa-circle-check text-emerald-400"></i>
                <div class="font-medieval font-bold text-emerald-400 text-xs" id="coupon-code-display"></div>
              </div>
              <button
                onclick="removeCoupon()"
                class="text-emerald-400 hover:text-emerald-300 p-1 bg-emerald-950/80 rounded-sm"
              >
                <i class="fa-solid fa-xmark text-xs"></i>
              </button>
            </div>
            <div class="text-[11px] font-medieval text-emerald-300 mt-2" id="coupon-description"></div>
          </div>

          <div id="coupon-input-container" class="flex items-center gap-2">
            <div class="relative flex-1">
              <input
                type="text"
                id="couponCode"
                class="w-full px-4 py-2.5 bg-realm-bg border border-realm-border rounded-sm focus:border-gold transition-all font-sans text-xs text-slate-100 placeholder:text-slate-600 uppercase"
                placeholder="KUPON KODUNUZ"
              >
            </div>
            <button
              onclick="applyCoupon()"
              id="applyCouponBtn"
              class="bg-realm-card hover:bg-realm-card text-gold-bright border border-realm-border-accent font-medieval font-bold rounded-sm px-4 py-2.5 transition-colors flex-shrink-0 text-xs uppercase"
            >
              UYGULA
            </button>
          </div>
        </div>

        <div class="space-y-3 mb-6 text-xs font-medieval">
          <div class="flex items-center justify-between text-slate-300">
            <span>Ara Toplam</span>
            <span id="subtotal" class="font-bold text-slate-100">0.00 ₺</span>
          </div>
          <div id="coupon-discount-row" class="hidden items-center justify-between text-emerald-400 font-bold">
            <span>Kupon İndirimi</span>
            <span id="coupon-discount">-0.00 ₺</span>
          </div>
        </div>

        <div class="rpg-divider my-4"></div>

        <div class="pt-2 mb-8">
          <div class="flex items-center justify-between">
            <span class="text-sm font-medieval font-bold text-slate-200 uppercase tracking-wider">TOPLAM TUTAR</span>
            <span id="total" class="text-2xl font-medieval font-black text-gold-bright drop-shadow-md">0.00 ₺</span>
          </div>
        </div>

        <button
          onclick="purchase()"
          id="purchaseBtn"
          class="w-full rpg-btn-sharp-gold py-4 rounded-sm font-medieval font-bold text-xs uppercase tracking-widest flex items-center justify-center gap-2 shadow-xl disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <i class="fa-solid fa-lock"></i>
          <span>SİPARİŞİ TAMAMLA</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  // Marketplace Settings injected from server
  const bulkDiscount = {% if marketplace and marketplace.bulkDiscount %}{{ marketplace.bulkDiscount | json }}{% else %}null{% endif %};
  const isCustomer = {% if customer %}true{% else %}false{% endif %};
  
  let cartProducts = [];
  let appliedCoupon = null;

  async function loadCart() {
    const cartStr = localStorage.getItem('cart');
    let cart = [];
    if (cartStr) {
      try {
        cart = JSON.parse(cartStr);
        const originalLength = cart.length;
        cart = cart.filter(item => item && item.id && String(item.id).trim() !== '');
        if (cart.length !== originalLength) {
          localStorage.setItem('cart', JSON.stringify(cart));
        }
      } catch(e){}
    }

    if (cart.length === 0) {
      document.getElementById('cart-loading').classList.add('hidden');
      document.getElementById('cart-empty').classList.remove('hidden');
      document.getElementById('cart-content').classList.add('hidden');
      updateCartHeaderCount();
      return;
    }

    try {
      cartProducts = cart.map(item => ({
        id: item.id || item._id,
        name: item.name || 'Eşya #' + (item.id || ''),
        price: Number(item.price) || 0,
        discountValue: Number(item.discountValue) || 0,
        discountType: item.discountType || 'fixed',
        image: item.image || item.imageUrl || '',
        quantity: Math.max(1, parseInt(item.quantity) || 1)
      }));
      document.getElementById('cart-loading').classList.add('hidden');
      
      if (cartProducts.length === 0) {
        document.getElementById('cart-empty').classList.remove('hidden');
        document.getElementById('cart-content').classList.add('hidden');
      } else {
        document.getElementById('cart-empty').classList.add('hidden');
        document.getElementById('cart-content').classList.remove('hidden');
        renderCart();
      }
    } catch(err) {
      console.error(err);
      document.getElementById('cart-loading').classList.add('hidden');
      window.showToast?.('Sepet yüklenirken hata oluştu', 'error');
    }
  }

  function renderCart() {
    const itemsContainer = document.getElementById('cart-items');
    itemsContainer.innerHTML = '';
    
    let totalSubtotal = 0;

    cartProducts.forEach(product => {
      const originalPrice = Number(product.price) || 0;
      const discountValue = Number(product.discountValue) || 0;
      const hasProductDiscount = discountValue > 0;
      
      let productDiscountedPrice = originalPrice;
      if (hasProductDiscount) {
        productDiscountedPrice = product.discountType === 'percentage'
          ? originalPrice - (originalPrice * discountValue / 100)
          : originalPrice - discountValue;
      }

      let bulkDiscountedPrice = originalPrice;
      let hasBulk = false;
      let bulkDiscountAmount = 0;

      if (bulkDiscount && bulkDiscount.amount > 0 && (!bulkDiscount.products || bulkDiscount.products.length === 0 || bulkDiscount.products.includes(product.id))) {
        hasBulk = true;
        if (bulkDiscount.type === 'percentage') {
          bulkDiscountAmount = (originalPrice * bulkDiscount.amount) / 100;
        } else {
          bulkDiscountAmount = bulkDiscount.amount;
        }
        bulkDiscountedPrice = originalPrice - bulkDiscountAmount;
      }

      let finalPrice = originalPrice;
      let badgeHtml = '';

      if (hasProductDiscount && hasBulk) {
        if (bulkDiscountedPrice < productDiscountedPrice) {
          finalPrice = bulkDiscountedPrice;
          badgeHtml = `<span class="px-2 py-0.5 bg-red-950/80 border border-red-800/60 text-red-400 rounded-sm text-[10px] font-medieval font-bold">${bulkDiscount.type === 'percentage' ? `%${bulkDiscount.amount} İndirim` : `${bulkDiscount.amount}₺ İndirim`}</span>`;
        } else {
          finalPrice = productDiscountedPrice;
          badgeHtml = `<span class="px-2 py-0.5 bg-red-950/80 border border-red-800/60 text-red-400 rounded-sm text-[10px] font-medieval font-bold">${product.discountType === 'percentage' ? `%${discountValue} İndirim` : `${discountValue}₺ İndirim`}</span>`;
        }
      } else if (hasBulk) {
        finalPrice = bulkDiscountedPrice;
        badgeHtml = `<span class="px-2 py-0.5 bg-red-950/80 border border-red-800/60 text-red-400 rounded-sm text-[10px] font-medieval font-bold">${bulkDiscount.type === 'percentage' ? `%${bulkDiscount.amount} İndirim` : `${bulkDiscount.amount}₺ İndirim`}</span>`;
      } else if (hasProductDiscount) {
        finalPrice = productDiscountedPrice;
        badgeHtml = `<span class="px-2 py-0.5 bg-red-950/80 border border-red-800/60 text-red-400 rounded-sm text-[10px] font-medieval font-bold">${product.discountType === 'percentage' ? `%${discountValue} İndirim` : `${discountValue}₺ İndirim`}</span>`;
      }

      let couponDiscount = 0;
      let hasCouponDiscount = false;
      if (appliedCoupon && appliedCoupon.type === 'product_discount') {
        if (!appliedCoupon.productId || product.id === appliedCoupon.productId) {
          hasCouponDiscount = true;
          if (appliedCoupon.discountType === 'percentage') {
            couponDiscount = (finalPrice * appliedCoupon.discountValue) / 100;
          } else {
            couponDiscount = appliedCoupon.discountValue;
          }
        }
      }

      const finalPriceWithCoupon = finalPrice - couponDiscount;
      const lineTotal = finalPriceWithCoupon * product.quantity;
      totalSubtotal += lineTotal;

      const imgUrl = product.image;
      const imgHtml = imgUrl ? `<img src="${imgUrl}" class="w-full h-full object-contain p-2 filter drop-shadow-md" alt="">` : `<div class="flex items-center justify-center text-gold/60 h-full"><i class="fa-solid fa-cube text-2xl"></i></div>`;

      let priceHtml = '';
      if (finalPrice < originalPrice || hasCouponDiscount) {
        priceHtml = `
          <div class="flex items-center gap-2 mt-1 flex-wrap">
            <span class="text-xs text-slate-500 line-through font-medieval">${originalPrice.toFixed(2)} ₺</span>
            <span class="font-medieval font-bold text-gold-bright text-sm">${Math.max(0, finalPriceWithCoupon).toFixed(2)} ₺</span>
            ${badgeHtml}
            ${hasCouponDiscount ? `<span class="px-2 py-0.5 bg-emerald-950/80 border border-emerald-800/60 text-emerald-400 rounded-sm text-[10px] font-medieval font-bold">Kuponlu</span>` : ''}
          </div>
        `;
      } else {
        priceHtml = `<div class="font-medieval font-bold text-gold-bright text-sm mt-1">${originalPrice.toFixed(2)} ₺</div>`;
      }

      itemsContainer.innerHTML += `
        <div class="flex items-center gap-5 p-5 hover:bg-realm-card/50 transition-colors">
          <div class="w-20 h-20 bg-realm-bg rounded-sm border border-realm-border flex-shrink-0">
            ${imgHtml}
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="font-medieval font-bold text-slate-100 truncate text-sm">
              <a href="/store/product/${product.id}" class="hover:text-gold-bright transition-colors">${product.name}</a>
            </h3>
            ${priceHtml}
          </div>
          <div class="flex items-center gap-4">
            <div class="flex items-center bg-realm-bg border border-realm-border rounded-sm">
              <button onclick="updateQty('${product.id}', ${product.quantity - 1})" class="w-7 h-7 flex items-center justify-center text-slate-400 hover:text-gold-bright hover:bg-realm-card transition-all"><i class="fa-solid fa-minus text-[10px]"></i></button>
              <span class="w-8 text-center font-medieval font-bold text-slate-100 text-xs">${product.quantity}</span>
              <button onclick="updateQty('${product.id}', ${product.quantity + 1})" class="w-7 h-7 flex items-center justify-center text-slate-400 hover:text-gold-bright hover:bg-realm-card transition-all"><i class="fa-solid fa-plus text-[10px]"></i></button>
            </div>
            <div class="w-24 text-right">
              <span class="font-medieval font-black text-gold-bright text-base">${Math.max(0, lineTotal).toFixed(2)} ₺</span>
            </div>
            <button onclick="removeFromCart('${product.id}')" class="w-8 h-8 flex items-center justify-center rounded-sm text-slate-500 hover:text-red-400 hover:bg-red-950/40 transition-colors flex-shrink-0">
              <i class="fa-solid fa-xmark text-sm"></i>
            </button>
          </div>
        </div>
      `;
    });

    document.getElementById('cart-count').innerText = cartProducts.length;

    let cartCouponDiscount = 0;
    if (appliedCoupon && appliedCoupon.type === 'cart_discount') {
      cartCouponDiscount = appliedCoupon.discountType === 'percentage'
        ? (totalSubtotal * appliedCoupon.discountValue) / 100
        : appliedCoupon.discountValue;
    }

    const grandTotal = Math.max(0, totalSubtotal - cartCouponDiscount);

    document.getElementById('subtotal').innerText = `${totalSubtotal.toFixed(2)} ₺`;
    if (cartCouponDiscount > 0) {
      document.getElementById('coupon-discount-row').classList.remove('hidden');
      document.getElementById('coupon-discount-row').classList.add('flex');
      document.getElementById('coupon-discount').innerText = `-${cartCouponDiscount.toFixed(2)} ₺`;
    } else {
      document.getElementById('coupon-discount-row').classList.add('hidden');
      document.getElementById('coupon-discount-row').classList.remove('flex');
    }
    
    document.getElementById('total').innerText = `${grandTotal.toFixed(2)} ₺`;
    
    updateCartHeaderCount();
  }

  function updateQty(id, newQty) {
    if (newQty < 1) {
      removeFromCart(id);
      return;
    }
    const idx = cartProducts.findIndex(p => p.id === id);
    if (idx !== -1) {
      cartProducts[idx].quantity = newQty;
      saveCart();
      renderCart();
    }
  }

  function removeFromCart(id) {
    cartProducts = cartProducts.filter(p => p.id !== id);
    saveCart();
    if (cartProducts.length === 0) {
      loadCart();
    } else {
      renderCart();
    }
  }

  let clearCartTimeout;
  function clearCart(btn) {
    if (btn.classList.contains('confirm-mode')) {
      cartProducts = [];
      appliedCoupon = null;
      saveCart();
      loadCart();
      
      btn.classList.remove('confirm-mode', 'bg-red-600', 'text-white');
      btn.classList.add('bg-[#1f1616]', 'text-red-400');
      btn.innerHTML = `<i class="fa-solid fa-trash-can"></i> <span>TEMİZLE</span>`;
      clearTimeout(clearCartTimeout);
    } else {
      btn.classList.add('confirm-mode', 'bg-red-600', 'text-white');
      btn.classList.remove('bg-[#1f1616]', 'text-red-400');
      btn.innerHTML = `<i class="fa-solid fa-circle-exclamation"></i> <span>EMİN MİSİN?</span>`;
      
      clearCartTimeout = setTimeout(() => {
        btn.classList.remove('confirm-mode', 'bg-red-600', 'text-white');
        btn.classList.add('bg-[#1f1616]', 'text-red-400');
        btn.innerHTML = `<i class="fa-solid fa-trash-can"></i> <span>TEMİZLE</span>`;
      }, 3000);
    }
  }

  function saveCart() {
    localStorage.setItem('cart', JSON.stringify(cartProducts));
    updateCartHeaderCount();
  }

  function updateCartHeaderCount() {
    const minCart = JSON.parse(localStorage.getItem('cart') || '[]');
    const badges = document.querySelectorAll('.header-cart-badge');
    badges.forEach(b => {
      b.innerText = minCart.length;
      if (minCart.length > 0) b.classList.remove('hidden');
      else b.classList.add('hidden');
    });
  }

  async function applyCoupon() {
    const code = document.getElementById('couponCode').value.trim();
    if (!code) return;
    
    const btn = document.getElementById('applyCouponBtn');
    const ogText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '...';

    try {
      const data = await window.crafter.coupons.get(code);
      const c = data?.data || (data?.code || data?.id ? data : null);
      if (c) {
        if (!c.isActive) {
          window.showToast('Kupon artık aktif değil.', 'error');
          return;
        }

        const currentSubtotal = cartProducts.reduce((sum, p) => sum + (Number(p.price) || 0) * p.quantity, 0);
        if (c.minCartValue && currentSubtotal < c.minCartValue) {
          window.showToast(`Minimum sepet tutarı: ${c.minCartValue}₺`, 'warning');
          return;
        }

        if (c.type === 'product_discount' && c.productId) {
          if (!cartProducts.some(p => p.id === c.productId)) {
            window.showToast('Bu kupon sepetinizdeki ürünler için geçerli değil.', 'error');
            return;
          }
        }

        appliedCoupon = c;
        document.getElementById('coupon-input-container').classList.add('hidden');
        document.getElementById('applied-coupon').classList.remove('hidden');
        document.getElementById('coupon-code-display').innerText = c.code;
        
        let desc = 'İndirim uygulandı';
        if (c.type === 'product_discount') desc = `Belirli ürünlere ${c.discountType==='percentage'?`%${c.discountValue}`:`${c.discountValue}₺`} indirim`;
        if (c.type === 'cart_discount') desc = `Sepete ${c.discountType==='percentage'?`%${c.discountValue}`:`${c.discountValue}₺`} indirim`;
        if (c.type === 'free_product') desc = `Ücretsiz ürün hediyesi!`;
        
        document.getElementById('coupon-description').innerText = desc;
        renderCart();
        window.showToast('Kupon uygulandı!', 'success');
      } else {
        window.showToast('Geçersiz kupon kodu.', 'error');
      }
    } catch (e) {
      window.showToast(e.message || 'Kupon kontrol edilemedi.', 'error');
    } finally {
      btn.disabled = false;
      btn.innerHTML = ogText;
    }
  }

  function removeCoupon() {
    appliedCoupon = null;
    document.getElementById('couponCode').value = '';
    document.getElementById('coupon-input-container').classList.remove('hidden');
    document.getElementById('applied-coupon').classList.add('hidden');
    renderCart();
  }

  let purchaseTimeout;
  async function purchase() {
    if (!isCustomer) {
      window.location.href = '/auth/sign-in?return=/cart';
      return;
    }

    if (cartProducts.length === 0) return;

    const btn = document.getElementById('purchaseBtn');
    const ogText = '<i class="fa-solid fa-lock"></i> <span>SİPARİŞİ TAMAMLA</span>';

    if (!btn.classList.contains('confirm-mode')) {
      btn.classList.add('confirm-mode');
      btn.innerHTML = '<i class="fa-solid fa-circle-question"></i> <span>ONAYLIYOR MUSUNUZ?</span>';
      
      purchaseTimeout = setTimeout(() => {
        btn.classList.remove('confirm-mode');
        btn.innerHTML = ogText;
      }, 3000);
      return;
    }
    
    clearTimeout(purchaseTimeout);
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner animate-spin"></i> <span>İŞLENİYOR...</span>';

    try {
      const items = cartProducts.map(p => ({ productId: p.id, quantity: p.quantity }));
      const payload = { items };
      if (appliedCoupon) payload.coupon = appliedCoupon.code;

      const data = await window.crafter.cart.purchase(payload);

      window.showToast('Sipariş başarıyla tamamlandı! Sandığa yönlendiriliyorsunuz.', 'success');
      localStorage.removeItem('cart');
      setTimeout(() => {
        window.location.href = '/chest';
      }, 2000);
    } catch (e) {
      window.showToast(e.message || 'Sipariş tamamlanamadı.', 'error');
      btn.disabled = false;
      btn.innerHTML = ogText;
    }
  }

  if (window.crafter) {
    window.crafter.on('cart:purchased', () => {
      localStorage.removeItem('cart');
      cartProducts = [];
      appliedCoupon = null;
      updateCartHeaderCount();
      loadCart();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadCart);
  } else {
    loadCart();
  }
</script>